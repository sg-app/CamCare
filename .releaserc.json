{
  "branches": [
    {
      "name": "main",
      "channel": "latest",
      "type": "release",
      "prerelease": false
    },
    {
      "name": "develop",
      "channel": "beta",
      "type": "prerelease",
      "prerelease": "beta"
    }
  ],
  "plugins": ["./.github/plugins/always-release.js", "@semantic-release/release-notes-generator", "@semantic-release/github"]
}
