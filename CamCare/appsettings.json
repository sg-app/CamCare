{
  "AllowedHosts": "*",
  "AppVersion": {
    "FullSemVer": "dev"
  },
  "ConnectionStrings": {
    "Default": "",
    "AmicronDatabase": "",
    "DefaultKrd": ""
  },
  "ObjectStorage": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "camcarefiles",
    "UseSsl": false,
    "PresignedUrlLifetimeMinutes": 15,
    "MaxFileSizeBytes": 104857600
  },
  "UploadLink": {
    "Secret": "",
    "TokenLifetimeMinutes": 20,
    "PublicBaseUrl": ""
  },
  "Mail": {
    "IsEnabled": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "Security": "StartTls",
    "UserName": "",
    "Password": "",
    "TimeoutSeconds": 30,
    "FromAddress": "",
    "FromName": ""
  },
  "MaxDegreeOfParallelismLoadMasterData": 10,
  "MasterdataCacheTtlMinutes": 60,
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "targets": {
      "file": {
        "type": "File",
        "fileName": "log/logfile.log",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}${exception:format=toString,StackTrace}",
        "maxArchiveFiles": 10,
        "archiveFileName": "log/logfile.{#}.log",
        "archiveAboveSize": 20971520,
        "archiveNumbering": "Rolling",
        "keepFileOpen": false
      },
      "console": {
        "type": "Console",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}${exception:format=toString,StackTrace}"
      },
      "debug": {
        "type": "Debugger",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}${exception:format=toString,StackTrace}"
      },
      "logconsole": {
        "type": "Console",
        "layout": {
          "type": "JsonLayout",
          "Attributes": [
            {
              "name": "time",
              "layout": "${date:format=yyyy-MM-ddTHH\\:mm\\:ss.ffffK}"
            },
            {
              "name": "level",
              "layout": "${level:upperCase=true}"
            },
            {
              "name": "message",
              "layout": "${message}"
            },
            {
              "name": "method",
              "layout": "${callsite}"
            },
            {
              "name": "pod",
              "layout": "${environment:HOSTNAME}"
            },
            {
              "name": "exception",
              "layout": {
                "type": "JsonLayout",
                "Attributes": [
                  {
                    "name": "type",
                    "layout": "${exception:format=type}"
                  },
                  {
                    "name": "message",
                    "layout": "${exception:format=message}"
                  },
                  {
                    "name": "stacktrace",
                    "layout": "${exception:format=tostring}"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "rules": [
      {
        "logger": "Microsoft.*",
        "finalMinLevel": "Warning",
        "writeTo": "file,console,debug,logconsole"
      },
      {
        "logger": "Microsoft.AspNetCore.*",
        "finalMinLevel": "Warning",
        "writeTo": "file,console,debug,logconsole"
      },
      {
        "logger": "Radzen.*",
        "finalMinLevel": "Warning",
        "writeTo": "file,console,debug,logconsole"
      },
      {
        "logger": "*",
        "minLevel": "Trace",
        "writeTo": "file,debug,logconsole"
      }
    ]
  }
}
