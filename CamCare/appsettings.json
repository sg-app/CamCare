{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "AmicronDatabase": "",
    "DefaultKrd": ""
  },
  "MaxDegreeOfParallelismLoadMasterData": 10,
  "MasterdataCacheTtlMinutes": 60,
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "targets": {
      "file": {
        "type": "File",
        "fileName": "log/logfile.log",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}${exception:format=toString,StackTrace}",
        "maxArchiveFiles": 10,
        "archiveFileName": "log/logfile.{#}.log",
        "archiveAboveSize": 20971520,
        "archiveNumbering": "Rolling",
        "keepFileOpen": false
      },
      "console": {
        "type": "Console",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}${exception:format=toString,StackTrace}"
      },
      "debug": {
        "type": "Debugger",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}${exception:format=toString,StackTrace}"
      }
    },
    "rules": [
      {
        "logger": "Microsoft.*",
        "finalMinLevel": "Info",
        "writeTo": "file,console,debug"
      },
      {
        "logger": "Radzen.*",
        "finalMinLevel": "Warning",
        "writeTo": "file,console,debug"
      },
      {
        "logger": "*",
        "minLevel": "Trace",
        "writeTo": "file,debug"
      }
    ]
  }
}
