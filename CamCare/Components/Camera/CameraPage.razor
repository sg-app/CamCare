@page "/CameraPage"

<InsertButton InsertClick="OnInsertClicked" />
<RadzenDataGrid @ref="_grid"
                TItem="CameraVm"
                Data="_data"
                LoadData="OnLoadData"
                IsLoading="_isLoading"
                Count="_totalCount"
                AllowPaging="true"
                PageSize="20"
                AllowFiltering="true"
                FilterMode="FilterMode.Simple"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                Density="Density.Compact"
                AllowColumnResize="true"
                ShowEmptyMessage="false"
                Style="width:800px">
    <Columns>
        <RadzenDataGridColumn TItem="CameraVm" Property="@nameof(CameraVm.SerialNumber)" Title="Seriennummer" MinWidth="200px" SortOrder="SortOrder.Ascending" />
        <RadzenDataGridColumn TItem="CameraVm" Property="@nameof(CameraVm.CameraType)" FilterProperty="CameraType.Name" Type="typeof(CameraTypeVm)" FilterOperator="FilterOperator.Contains" Title="Typ" MinWidth="200px">
            <Template Context="item">
                @item.CameraType?.Name
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridInlineEditColumn TItem="CameraVm" DeleteRow="OnDeleteRowClicked" CanEdit="(item) => false" />
    </Columns>
    <Template Context="item">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenText Style="width:150px">Kundennummer:</RadzenText>
                <RadzenText>@item.Customer?.Id</RadzenText>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" Visible="@(!string.IsNullOrEmpty(item.Customer?.CompanyName))">
                <RadzenText Style="width:150px">Firma:</RadzenText>
                <RadzenText>@item.Customer?.CompanyName</RadzenText>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" Visible="@(!string.IsNullOrEmpty(item.Customer?.FirstName))">
                <RadzenText Style="width:150px">Vorname:</RadzenText>
                <RadzenText>@item.Customer?.FirstName</RadzenText>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" Visible="@(!string.IsNullOrEmpty(item.Customer?.LastName))">
                <RadzenText Style="width:150px">Nachname:</RadzenText>
                <RadzenText>@item.Customer?.LastName</RadzenText>
            </RadzenStack>
        </RadzenStack>
    </Template>
</RadzenDataGrid>

@code {
    [Inject] protected ICameraService CameraService { get; set; } = default!;
    [Inject] protected DialogService DialogService { get; set; } = default!;
    [Inject] protected IJSRuntime JSRuntime { get; set; } = default!;

    private RadzenDataGrid<CameraVm> _grid = default!;
    private IList<CameraVm>? _data;
    private int _totalCount;
    private bool _isLoading;

    private async Task OnLoadData(LoadDataArgs args)
    {
        _isLoading = true;
        var response = await CameraService.GetAllAsync(args);
        if (response.Success)
        {
            _data = response.Data?.Items.ToList();
            _totalCount = response.Data?.TotalCount ?? 0;
        }
        _isLoading = false;
    }

    private async Task OnInsertClicked(MouseEventArgs args)
    {
        if (!_grid.IsValid) return;
        var item = new CameraVm();
        await _grid.InsertRow(item);
    }

    private async Task OnDeleteRowClicked(CameraVm item)
    {
        var dialogResult = await DialogService.Confirm("Soll der Datensatz wirklich gelöscht werden?", "Datensatz löschen", new ConfirmOptions { OkButtonText = "Ja", CancelButtonText = "Nein" });
        if (dialogResult != true) return;

        await CameraService.DeleteAsync(item.SerialNumber);
        await _grid.Reload();
    }
}
