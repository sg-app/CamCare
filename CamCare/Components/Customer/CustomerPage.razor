@page "/CustomerPage"


<InsertButton InsertClick="OnInsertClicked" />
<RadzenDataGrid @ref="_grid"
                TItem="CustomerVm"
                Data="_data"
                LoadData="OnLoadData"
                IsLoading="_isLoading"
                Count="_totalCount"
                AllowPaging="true"
                PageSize="20"
                AllowFiltering="true"
                FilterMode="FilterMode.Simple"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                Density="Density.Compact"
                AllowColumnResize="true"
                ShowEmptyMessage="false">
    <Columns>
        <RadzenDataGridColumn TItem="CustomerVm" Property="@nameof(CustomerVm.Id)" Title="Kundennummer" MinWidth="250px" SortOrder="SortOrder.Ascending" />
        <RadzenDataGridColumn TItem="CustomerVm" Property="@nameof(CustomerVm.CompanyName)" Title="Firma" MinWidth="200px" />
        <RadzenDataGridColumn TItem="CustomerVm" Property="@nameof(CustomerVm.FirstName)" Title="Vorame" MinWidth="200px" />
        <RadzenDataGridColumn TItem="CustomerVm" Property="@nameof(CustomerVm.LastName)" Title="Nachname" MinWidth="200px" />
        <RadzenDataGridColumn TItem="CustomerVm" Property="@nameof(CustomerVm.Email)" Title="Eamil" MinWidth="200px" />
        <RadzenDataGridColumn TItem="CustomerVm" Property="@nameof(CustomerVm.PhoneNumber)" Title="Telefon" MinWidth="200px" />
        <RadzenDataGridInlineEditColumn TItem="CustomerVm" DeleteRow="OnDeleteRowClicked" EditRow="OnEditRowClicked" />
    </Columns>
    <Template Context="item">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="3rem" Wrap="FlexWrap.Wrap">
            <AddressInfo Address="@item.Addresses?.FirstOrDefault(x => x.AddressType == AddressType.Billing)" />
            <AddressInfo Address="@item.Addresses?.FirstOrDefault(x => x.AddressType == AddressType.Shipping)" />
        </RadzenStack>
        @if (item.Cameras?.Any() == true && item.Cameras.Count >= 1)
        {
            <RadzenFieldset Text="Kameras" Style="width:500px">
                <RadzenTable AllowAlternatingRows="true">
                    <RadzenTableHeader>
                        <RadzenTableHeaderRow>
                            <RadzenTableHeaderCell>
                                Seriennummer
                            </RadzenTableHeaderCell>
                            <RadzenTableHeaderCell>
                                Typ
                            </RadzenTableHeaderCell>
                        </RadzenTableHeaderRow>
                    </RadzenTableHeader>
                    <RadzenTableBody>
                        @foreach (var camera in item.Cameras)
                        {
                            <RadzenTableRow>
                                <RadzenTableCell>
                                    @camera.SerialNumber
                                </RadzenTableCell>
                                <RadzenTableCell>
                                    @camera.CameraType?.Name
                                </RadzenTableCell>
                            </RadzenTableRow>
                        }
                    </RadzenTableBody>
                </RadzenTable>
            </RadzenFieldset>
        }
    </Template>
</RadzenDataGrid>

@code {
    [Inject] protected ICustomerService CustomerService { get; set; } = default!;
    [Inject] protected DialogService DialogService { get; set; } = default!;
    [Inject] protected NavigationManager NavigationManager { get; set; } = default!;

    private RadzenDataGrid<CustomerVm> _grid = default!;
    private IList<CustomerVm>? _data;
    private int _totalCount;
    private bool _isLoading;

    private async Task OnLoadData(LoadDataArgs args)
    {
        _isLoading = true;
        var response = await CustomerService.GetAllAsync(args);
        if (response.Success)
        {
            _data = response.Data?.Items.ToList();
            _totalCount = response.Data?.TotalCount ?? 0;
        }
        _isLoading = false;
    }

    private void OnInsertClicked(MouseEventArgs args)
    {
        NavigationManager.NavigateTo($"Customer/?IsEditFromCustomerPage=true");
    }

    private void OnEditRowClicked(CustomerVm item)
    {
        NavigationManager.NavigateTo($"Customer/{item.Id}?IsEditFromCustomerPage=true");
    }

    private async Task OnDeleteRowClicked(CustomerVm item)
    {
        var dialogResult = await DialogService.Confirm("Soll der Datensatz wirklich gelöscht werden?", "Datensatz löschen", new ConfirmOptions { OkButtonText = "Ja", CancelButtonText = "Nein" });
        if (dialogResult != true) return;

        await CustomerService.DeleteAsync(item.Id);
        await _grid.Reload();
    }
}
