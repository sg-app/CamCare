@page "/CustomerPage"
@using CamCare.Models.Amicron


<RadzenDataGrid @ref="_grid"
                TItem="Adressen"
                Data="_data"
                LoadData="OnLoadData"
                IsLoading="_isLoading"
                Count="_totalCount"
                AllowPaging="true"
                PageSize="20"
                AllowFiltering="true"
                FilterMode="FilterMode.Simple"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                Density="Density.Compact"
                AllowColumnResize="true"
                ShowEmptyMessage="false">
    <Columns>
        <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.LfdNr)" Title="Nummer" Width="80px" SortOrder="SortOrder.Ascending" Filterable="false" />
        <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.KdNummer)" Title="Kundennummer" Width="100px" Filterable="false" />
        <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.Suchbegriff)" Title="Suchbegriff" MinWidth="200px" />
        <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.Vorname)" Title="Vorname" MinWidth="200px" Filterable="false" />
        <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.Name)" Title="Nachname" MinWidth="200px" Filterable="false" />
        <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.Strasse)" Title="Straße" MinWidth="200px" Filterable="false" />
        <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.Plz)" Title="PLZ" Width="80px" Filterable="false" />
        <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.Ort)" Title="Ort" MinWidth="200px" Filterable="false" />
    </Columns>
</RadzenDataGrid>

@code {

    [Inject] protected DialogService DialogService { get; set; } = default!;
    [Inject] protected NavigationManager NavigationManager { get; set; } = default!;
    [Inject] protected IAmicronDataService AmicronDataService { get; set; } = default!;
    private RadzenDataGrid<Adressen> _grid = default!;
    private IList<Adressen>? _data;
    private int _totalCount;
    private bool _isLoading;

    private async Task OnLoadData(LoadDataArgs args)
    {
        _isLoading = true;
        var response = await AmicronDataService.GetAllAddressAsync(args);
        if (response.Success)
        {
            _data = response.Data?.Items.ToList();
            _totalCount = response.Data?.TotalCount ?? 0;
        }
        _isLoading = false;
    }
}
