@inherits LayoutComponentBase
<RadzenComponents @rendermode="InteractiveServer" />
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => sidebar1Expanded = !sidebar1Expanded)" />
            <RadzenLabel Text="CamCare - Kamerareparatur Erfassung" />
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@sidebar1Expanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Icon="home" Path="/" />
            <RadzenPanelMenuItem Text="Aufträge" Icon="order_approve" Path="RepairOrderPage" />
            <RadzenPanelMenuItem Text="Stammdaten" Icon="database">
                <RadzenPanelMenuItem Text="Kunden" Icon="group" Path="CustomerPage" />
                <RadzenPanelMenuItem Text="Kameras" Icon="video_camera_back" Path="CameraPage" />
                <RadzenPanelMenuItem Text="Status" Icon="sweep" Path="RepairOrderStatusPage" />
                <RadzenPanelMenuItem Text="Defekte" Icon="broken_image" Path="DefectivePage" />
                <RadzenPanelMenuItem Text="Reparaturen" Icon="build" Path="RepairPositionPage" />
                <RadzenPanelMenuItem Text="Kameratypen" Icon="flip_camera_ios" Path="CameraTypePage" />
                <RadzenPanelMenuItem Text="Mitarbeiter" Icon="person_apron" Path="EmployeePage" />
                <RadzenPanelMenuItem Text="Logistikpartner" Icon="delivery_truck_speed" Path="LogisticProviderPage" />
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Auftrag erstellen" Icon="add_task" Path="RepairOrderEditorPage" />
            <RadzenPanelMenuItem Text="Alte Aufträge" Icon="elderly" Path="KrdDataPage" />
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        @Body
        <div id="blazor-error-ui">
            An unhandled error has occurred.
            <a href="" class="reload">Reload</a>
            <a class="dismiss">🗙</a>
        </div>
    </RadzenBody>
    <RadzenFooter>
        Copyright © 2025 SGApp
    </RadzenFooter>
</RadzenLayout>

@code {
    bool sidebar1Expanded = true;
}


