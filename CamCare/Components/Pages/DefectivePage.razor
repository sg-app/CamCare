@page "/DefectivePage"


<InsertButton InsertClick="OnInsertClicked" />
<RadzenDataGrid @ref="_grid"
                TItem="DefectiveVm"
                Data="_data"
                LoadData="OnLoadData"
                IsLoading="_isLoading"
                Count="_totalCount"
                AllowPaging="true"
                PageSize="20"
                AllowFiltering="true"
                FilterMode="FilterMode.Simple"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                RowUpdate="OnRowUpdate"
                RowCreate="OnRowCreate"
                Density="Density.Compact"
                AllowColumnResize="true"
                ShowEmptyMessage="false">
    <Columns>
        <RadzenDataGridColumn TItem="DefectiveVm" Property="@nameof(DefectiveVm.Description)" Title="Beschreibung">
            <EditTemplate Context="item">
                <RadzenTextBox @bind-Value="item.Description" Style="width:100%" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridInlineEditColumn TItem="DefectiveVm" EditRow="OnEditRowClicked" DeleteRow="OnDeleteRowClicked" CancelEditRow="OnCancelEditRowClicked" SaveRow="OnSaveRowClicked" />
    </Columns>
</RadzenDataGrid>

@code {
    [Inject] protected IDefectiveService DefectiveService { get; set; } = default!;
    [Inject] protected DialogService DialogService { get; set; } = default!;

    private RadzenDataGrid<DefectiveVm> _grid = default!;
    private IList<DefectiveVm>? _data;
    private int _totalCount;
    private bool _isLoading;
    private async Task OnLoadData(LoadDataArgs args)
    {
        _isLoading = true;
        var response = await DefectiveService.GetAllAsync(args);
        if (response.Success)
        {
            _data = response.Data?.Items.ToList();
            _totalCount = response.Data?.TotalCount ?? 0;
        }
        _isLoading = false;
    }

    private async Task OnInsertClicked(MouseEventArgs args)
    {
        if (!_grid.IsValid) return;
        var item = new DefectiveVm();
        await _grid.InsertRow(item);
    }

    private async Task OnRowUpdate(DefectiveVm item)
    {
        await DefectiveService.UpdateAsync(item.Id, item);
        await _grid.Reload();
    }

    private async Task OnRowCreate(DefectiveVm item)
    {
        await DefectiveService.CreateAsync(item);
        await _grid.Reload();
    }

    private async Task OnEditRowClicked(DefectiveVm item)
    {
        if (!_grid.IsValid) return;
        await _grid.EditRow(item);
    }

    private async Task OnDeleteRowClicked(DefectiveVm item)
    {
        var dialogResult = await DialogService.Confirm("Soll der Datensatz wirklich gelöscht werden?", "Datensatz löschen", new ConfirmOptions { OkButtonText = "Ja", CancelButtonText = "Nein" });
        if (dialogResult != true) return;

        await DefectiveService.DeleteAsync(item.Id);
        await _grid.Reload();
    }

    private async Task OnCancelEditRowClicked(DefectiveVm item)
    {
        _grid.CancelEditRow(item);
        await _grid.Reload();
    }

    private async Task OnSaveRowClicked(DefectiveVm item)
    {
        await _grid.UpdateRow(item);
    }
}
