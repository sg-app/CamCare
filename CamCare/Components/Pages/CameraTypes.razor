@page "/CameraTypes"


<InsertButton InsertClick="OnInsertClicked" />
<RadzenDataGrid @ref="_grid"
                TItem="CameraTypeVm"
                Data="@(MasterdataService.Get<CameraTypeVm>())"
                AllowPaging="true"
                PageSize="20"
                AllowFiltering="@(MasterdataService.Get<CameraTypeVm>().Count >= 20 ? true : false)"
                FilterMode="FilterMode.Simple"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                RowUpdate="OnRowUpdate"
                RowCreate="OnRowCreate"
                Density="Density.Compact" 
                AllowColumnResize="true"
                ShowEmptyMessage="false"
                Style="width:800px">
    <Columns>
        <RadzenDataGridColumn TItem="CameraTypeVm" Property="@nameof(CameraTypeVm.Name)" Title="Name" MinWidth="200px" FilterPlaceholder="Filter">
            <EditTemplate Context="item">
                <RadzenTextBox @bind-Value="item.Name" Style="width:100%" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridInlineEditColumn TItem="CameraTypeVm" EditRow="OnEditRowClicked" DeleteRow="OnDeleteRowClicked" CancelEditRow="OnCancelEditRowClicked" SaveRow="OnSaveRowClicked" />
    </Columns>
</RadzenDataGrid>

@code {
    [Inject] protected ICameraTypeService CameraTypeService { get; set; } = default!;
    [Inject] protected IMasterdataService MasterdataService { get; set; } = default!;
    [Inject] protected DialogService DialogService { get; set; } = default!;
    [Inject] protected IJSRuntime JSRuntime { get; set; } = default!;

    private RadzenDataGrid<CameraTypeVm> _grid = default!;
  
    private async Task OnInsertClicked(MouseEventArgs args)
    {
        if (!_grid.IsValid) return;
        var item = new CameraTypeVm();
        await _grid.InsertRow(item);
    }

    private async Task OnRowUpdate(CameraTypeVm item)
    {
        await CameraTypeService.UpdateAsync(item.Id, item);
        await MasterdataService.ReloadAsync<CameraTypeVm>();
        await _grid.Reload();
    }

    private async Task OnRowCreate(CameraTypeVm item)
    {
        await CameraTypeService.CreateAsync(item);
        await MasterdataService.ReloadAsync<CameraTypeVm>();
        await _grid.Reload();
    }

    private async Task OnEditRowClicked(CameraTypeVm item)
    {
        if (!_grid.IsValid) return;
        await _grid.EditRow(item);
    }

    private async Task OnDeleteRowClicked(CameraTypeVm item)
    {
        var dialogResult = await DialogService.Confirm("Soll der Datensatz wirklich gelöscht werden?", "Datensatz löschen", new ConfirmOptions { OkButtonText = "Ja", CancelButtonText = "Nein" });
        if (dialogResult != true) return;

        await CameraTypeService.DeleteAsync(item.Id);
        await MasterdataService.ReloadAsync<CameraTypeVm>();
        await _grid.Reload();
    }

    private async Task OnCancelEditRowClicked(CameraTypeVm item)
    {
        _grid.CancelEditRow(item);
        await _grid.Reload();
    }

    private async Task OnSaveRowClicked(CameraTypeVm item)
    {
        await _grid.UpdateRow(item);
    }
}
