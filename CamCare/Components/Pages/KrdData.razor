@page "/KrdData"

<RadzenDataGrid @ref="_grid"
                TItem="Krd_DataVm"
                Data="_data"
                LoadData="OnLoadData"
                IsLoading="_isLoading"
                Count="_totalCount"
                AllowPaging="true"
                PageSize="20"
                AllowFiltering="true"
                FilterMode="FilterMode.Simple"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                Density="Density.Compact"
                AllowColumnResize="true"
                ShowEmptyMessage="false">
    <Columns>
        <RadzenDataGridColumn TItem="Krd_DataVm" Property="@nameof(Krd_DataVm.Kunde)" Title="Kunde" MinWidth="200px" />
        <RadzenDataGridColumn TItem="Krd_DataVm" Property="@nameof(Krd_DataVm.CameraSerial)" Title="Seriennummer" Width="120px" />
        <RadzenDataGridColumn TItem="Krd_DataVm" Property="@nameof(Krd_DataVm.Description)" Title="Beschreibung" MinWidth="200px" />
        <RadzenDataGridColumn TItem="Krd_DataVm" Property="@nameof(Krd_DataVm.CameraType)" Title="Typ" Width="120px" />
        <RadzenDataGridColumn TItem="Krd_DataVm" Property="@nameof(Krd_DataVm.AdditionalComponents)" Title="Mitgeliefert" MinWidth="200px" />
        <RadzenDataGridColumn TItem="Krd_DataVm" Property="@nameof(Krd_DataVm.AmicronNumbers)" Title="Amicron" Width="100px" />
        <RadzenDataGridColumn TItem="Krd_DataVm" Property="@nameof(Krd_DataVm.ArrivedAt)" Title="Eingetroffen" Width="180px" FormatString="{0:dd.MM.yyyy HH:mm:ss}" SortOrder="SortOrder.Descending" />
        <RadzenDataGridColumn TItem="Krd_DataVm" Property="@nameof(Krd_DataVm.Techniker)" Title="Techniker" Width="200px" />
    </Columns>
</RadzenDataGrid>

@code {
    [Inject] protected IKrdDataService KrdDataService { get; set; } = default!;
    [Inject] protected DialogService DialogService { get; set; } = default!;
    [Inject] protected IJSRuntime JSRuntime { get; set; } = default!;

    private RadzenDataGrid<Krd_DataVm> _grid = default!;
    private IList<Krd_DataVm>? _data;
    private int _totalCount;
    private bool _isLoading;
    private async Task OnLoadData(LoadDataArgs args)
    {
        _isLoading = true;
        var response = await KrdDataService.GetAllAsync(args);
        if (response.Success)
        {
            _data = response.Data?.Items.ToList();
            _totalCount = response.Data?.TotalCount ?? 0;
        }
        _isLoading = false;
    }

}
