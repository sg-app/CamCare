@page "/RepairOrders"
@attribute [Authorize]
@using CamCare.Store.RepairOrderFeature
@implements IDisposable

<div class="pe-2">
    <RadzenCheckBox TValue="bool" Value="_archiveOrders"
                    ValueChanged="@((val) => { _archiveOrders = val; _grid.Reload(); })" Name="_archiveOrders" />
    <RadzenLabel Text="Archivierte Aufträge" Component="_archiveOrders" class="rz-ms-2" />
</div>
<AuthorizeView Policy="@AuthPolicies.CanCreateOrders">
    <InsertButton InsertClick="OnInsertClicked" />
</AuthorizeView>

<RadzenDataGrid @ref="_grid" Render="@OnRender" TItem="RepairOrderVm" Data="_data" LoadData="OnLoadData"
                IsLoading="_isLoading" Count="_totalCount" AllowPaging="true" PageSizeOptions="@pageSizeOptions" PageSize="50"
                Density="Density.Compact" AllowColumnResize="true" AllowSorting="true" AllowMultiColumnSorting="true"
                ShowMultiColumnSortingIndex="true" ShowEmptyMessage="false" FilterMode="FilterMode.Simple"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
    <Columns>
        <RadzenDataGridColumn TItem="RepairOrderVm" Title="Auftrag" Property="Id" Width="80px" Filterable="false" />
        @* Gefiltert wird über den Fremdschlüssel (int). Ein "In"-Filter auf der
           Navigationseigenschaft "RepairOrderStatus" erzeugt einen Entity-Vergleich,
           den EF Core nicht in SQL übersetzen kann. *@
        <RadzenDataGridColumn TItem="RepairOrderVm" Title="Status" Property="@nameof(RepairOrderVm.RepairOrderStatusId)"
                              FilterValue="@SelectedStateIds" FilterOperator="FilterOperator.In"
                              LogicalFilterOperator="LogicalFilterOperator.Or" Width="180px">
            <FilterTemplate>
                <RadzenDropDown @bind-Value=@SelectedStateIds Multiple="true" AllowSelectAll=false Style="width:100%;"
                                Data=@(MasterdataService.Get<RepairOrderStatusVm>())
                                TextProperty="@nameof(RepairOrderStatusVm.Name)"
                                ValueProperty="@nameof(RepairOrderStatusVm.Id)" />
            </FilterTemplate>
            <Template Context="item">
                <RadzenBadge Style="@item.RepairOrderStatus?.BadageStyle">@item.RepairOrderStatus?.Name</RadzenBadge>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RepairOrderVm" Title="Status vom" Property="@nameof(RepairOrderVm.CurrentStateAt)"
                              Width="150px" Filterable="false">
            <Template Context="item">
                @item.CurrentStateAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RepairOrderVm" Title="Kunde" Property="@nameof(RepairOrderVm.CustomerId)"
                              MinWidth="300px">
            <Template Context="item">
                @item.Customer?.DisplayName
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RepairOrderVm" Title="Auftragsnummer" Property="@nameof(RepairOrderVm.OrderNumber)"
                              Width="150px" />
        <RadzenDataGridColumn TItem="RepairOrderVm" Title="Seriennummer" Property="SerialNumber" Width="220px">
            <Template Context="item">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                    @if (item.SerialNumberNeedsMaintenance || item.IsCamera is null)
                    {
                        <RadzenIcon Icon="warning" IconColor="@Colors.Warning" />
                        @item.CameraSerialNumber
                    }
                    else
                    {
                        @item.CameraSerialNumber
                    }
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RepairOrderVm" Title="Priorität" Property="@nameof(RepairOrderVm.PriorityRepair)"
                              Width="100px" Filterable="false">
            <Template Context="item">
                @{
                    var icon = item.PriorityRepair ?? false ? "check_box" :
                "check_box_outline_blank";
                    var color = item.PriorityRepair ?? false ? "orange" : "black";
                }
                <RadzenIcon Icon="@icon" IconColor="@color" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RepairOrderVm" Title="Garantie" Width="100px" Filterable="false">
            <Template Context="item">
                @{
                    var icon = item.Warranty ? "check_box" :
                "check_box_outline_blank";
                }
                <RadzenIcon Icon="@icon" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RepairOrderVm" Title="Eingetroffen" Property="@nameof(RepairOrderVm.ArrivedAt)"
                              Width="150px">
            <Template Context="item">
                @item.ArrivedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridInlineEditColumn TItem="RepairOrderVm" EditRow="OnEditRowClicked" DeleteRow="OnDeleteRowClicked"
                                        CanDelete="(_) => _isAdmin" />
    </Columns>
    <Template Context="item">
        @{
            var serials = GetSerials(item);
        }
        @if (serials.Count > 0)
        {
            <RadzenText TextStyle="TextStyle.H5" class="d-block">
                Seriennummern
            </RadzenText>
            <div class="pt-1 pb-2">
                @foreach (var serial in serials)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        @if (serial.NeedsMaintenance)
                        {
                            <RadzenIcon Icon="warning" IconColor="@Colors.Warning" />
                        }
                        <span>@serial.SerialNumber</span>
                        @if (serial.IsPrimary)
                        {
                            <RadzenBadge Text="Hauptseriennummer" BadgeStyle="BadgeStyle.Light" Variant="Variant.Flat" />
                        }
                        @if (GetArticleText(serial) is string articleText)
                        {
                            <span class="text-secondary">@articleText</span>
                        }
                    </div>
                    @if (serial.IsForeignCustomer)
                    {
                        <div class="text-warning">@GetForeignCustomerText(serial)</div>
                    }
                    @if (serial.NeedsMaintenance)
                    {
                        <div class="text-danger">Seriennummer muss gepflegt werden.</div>
                    }
                }
            </div>
        }
        @if (item.IncludedComponents?.Any() == true && item.IncludedComponents.Count >= 1)
        {
            <RadzenText TextStyle="TextStyle.H5" class="d-block">
                Mitgelieferte Komponenten
            </RadzenText>
            @foreach (var includedComonents in item.IncludedComponents ?? [])
            {
                <RadzenText class="d-block">
                    @includedComonents.Description
                </RadzenText>
            }
        }
        @if (item.DeliveryAddress is not null)
        {
            <RadzenText TextStyle="TextStyle.H5" class="d-block">
                Lieferanschrift:
            </RadzenText>
            <div class="d-block">@item.DeliveryAddress.Recipient</div>
            @if (!string.IsNullOrWhiteSpace(item.DeliveryAddress.ContactPerson))
            {
                <div class="d-block">Ansprechpartner: @item.DeliveryAddress.ContactPerson</div>
            }
            <div class="d-block">@item.DeliveryAddress.Street</div>
            <div class="d-block">@item.DeliveryAddress.Country @item.DeliveryAddress.PostalCode @item.DeliveryAddress.City
            </div>
        }
        @if (item.EmailAddresses?.Any() == true)
        {
            <RadzenText TextStyle="TextStyle.H5" class="d-block pt-2">
                E-Mail-Adressen:
            </RadzenText>
            @foreach (var emailAddress in item.EmailAddresses)
            {
                <div class="d-block">@emailAddress.DisplayName</div>
            }
        }
        <RadzenText TextStyle="TextStyle.H5" class="d-block pt-2">
            Defekt:
        </RadzenText>
        @foreach (var defective in item.Defectives ?? [])
        {
            <div class="d-block">- @defective.Description</div>
        }
        <RadzenText TextStyle="TextStyle.H5" class="d-block">
            Ausgeführte Arbeiten:
        </RadzenText>
        @foreach (var work in item.Works ?? [])
        {
            <div class="d-block">- @work.Description</div>
        }
        <RadzenFieldset Text="Zu berechnende Artikel">
            @if (item.RepairPositions?.Any() == true && item.RepairPositions.Count >= 1)
            {
                <RadzenTable AllowAlternatingRows="true">
                    <RadzenTableHeader>
                        <RadzenTableHeaderRow>
                            <RadzenTableHeaderCell Style="width:150px">
                                Artikelnummer
                            </RadzenTableHeaderCell>
                            <RadzenTableHeaderCell Style="width:100px">
                                Anzahl
                            </RadzenTableHeaderCell>
                            <RadzenTableHeaderCell>
                                Beschreibung
                            </RadzenTableHeaderCell>
                        </RadzenTableHeaderRow>
                    </RadzenTableHeader>
                    <RadzenTableBody>
                        @foreach (var repair in item.RepairPositions ?? [])
                        {
                            <RadzenTableRow>
                                <RadzenTableCell>
                                    @repair.Artikelnummer
                                </RadzenTableCell>
                                <RadzenTableCell>
                                    @repair.Quantity
                                </RadzenTableCell>
                                <RadzenTableCell>
                                    @repair.Description
                                </RadzenTableCell>
                            </RadzenTableRow>
                        }
                    </RadzenTableBody>
                </RadzenTable>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.H6">Keine Reparaturen durchgeführt.</RadzenText>
            }
        </RadzenFieldset>
        <RadzenFieldset Text="Status Historie">
            @if (item.RepairOrderStatusHistories?.Any() == true)
            {
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    @foreach (var history in item.RepairOrderStatusHistories)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenText>
                                @history.ChangedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </RadzenText>
                            <RadzenBadge Style="@history.BadageStyle">
                                @history.DisplayStatusName
                            </RadzenBadge>
                        </RadzenStack>
                    }
                </RadzenStack>
            }
        </RadzenFieldset>
    </Template>
</RadzenDataGrid>

@code {
    [Inject] protected IRepairOrderService RepairOrderService { get; set; } = default!;
    [Inject] protected NavigationManager NavigationManager { get; set; } = default!;
    [Inject] protected IDispatcher Dispatcher { get; set; } = default!;
    [Inject] protected IRepairOrderChangeSubscriber RepairOrderChangeSubscriber { get; set; } = default!;
    [Inject] protected IMasterdataService MasterdataService { get; set; } = default!;
    [Inject] protected ILogger<RepairOrders> Logger { get; set; } = default!;
    [Inject] protected DialogService DialogService { get; set; } = default!;
    [Inject] protected AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;

    private RadzenDataGrid<RepairOrderVm> _grid = default!;
    private IEnumerable<int> pageSizeOptions = new int[] { 20, 50, 100 };
    private IList<RepairOrderVm>? _data;
    private int _totalCount;
    private bool _isLoading;
    private bool _archiveOrders;
    private bool _isAdmin;

    /// <summary>
    /// Ausgewählte Status-Ids des Spaltenfilters. Eine leere Auswahl wird als
    /// <c>null</c> abgelegt, damit Radzen gar keinen Filter erzeugt – sonst würde
    /// ein "In"-Filter ohne Werte (WHERE 0 = 1) alle Aufträge ausblenden.
    /// </summary>
    private IEnumerable<int>? SelectedStateIds
    {
        get => _selectedStateIds;
        set => _selectedStateIds = value?.Any() == true ? value : null;
    }

    private IEnumerable<int>? _selectedStateIds;

    private async Task OnLoadData(LoadDataArgs args)
    {
        _isLoading = true;
        var response = await RepairOrderService.GetAllAsync(args, !_archiveOrders);
        if (response.Success)
        {
            _data = response.Data?.Items.ToList();
            _totalCount = response.Data?.TotalCount ?? 0;
        }
        _isLoading = false;
    }

    private void OnRender(DataGridRenderEventArgs<RepairOrderVm> args)
    {
        if (args.FirstRender && args?.Grid is not null)
        {
            args.Grid.Sorts.Add(new SortDescriptor()
            {
                Property = nameof(RepairOrderVm.PriorityRepair),
                SortOrder =
SortOrder.Descending
            });
            args.Grid.Sorts.Add(new SortDescriptor()
            {
                Property = nameof(RepairOrderVm.ArrivedAt),
                SortOrder = SortOrder.Ascending
            });
        }
    }

    /// <summary>
    /// Liefert die dem Auftrag zugeordneten Seriennummern für die Detailansicht. Bei
    /// Bestandsaufträgen (vor Einführung der Mehrfach-Seriennummern) existieren noch keine
    /// Einträge – dann wird die Hauptseriennummer des Auftrags angezeigt.
    /// </summary>
    private static IReadOnlyList<RepairOrderSerialVm> GetSerials(RepairOrderVm item)
    {
        if (item.RepairOrderSerials is { Count: > 0 })
            return item.RepairOrderSerials
                .OrderByDescending(s => s.IsPrimary)
                .ThenBy(s => s.Id)
                .ToList();

        if (string.IsNullOrWhiteSpace(item.CameraSerialNumber))
            return [];

        return
        [
            new RepairOrderSerialVm
            {
                SerialNumber = item.CameraSerialNumber,
                NeedsMaintenance = item.SerialNumberNeedsMaintenance,
                IsPrimary = true
            }
        ];
    }

    /// <summary>
    /// Artikelangaben ("Artikelnummer – Bezeichnung") einer dem Auftrag zugewiesenen
    /// Seriennummer. Liefert null, wenn keine Angaben hinterlegt sind.
    /// </summary>
    private static string? GetArticleText(RepairOrderSerialVm serial)
    {
        var parts = new[] { serial.ArticleNumber, serial.ArticleDescription }
            .Where(part => !string.IsNullOrWhiteSpace(part));

        return parts.Any() ? string.Join(" – ", parts) : null;
    }

    /// <summary>
    /// Hinweistext für eine Seriennummer, die in Amicron einem anderen Kunden als dem
    /// Auftragskunden zugeordnet ist.
    /// </summary>
    private static string GetForeignCustomerText(RepairOrderSerialVm serial)
    {
        var customer = string.IsNullOrWhiteSpace(serial.OwnerCustomerNumber)
            ? serial.OwnerCustomerName
            : $"{serial.OwnerCustomerNumber} – {serial.OwnerCustomerName}";

        return string.IsNullOrWhiteSpace(customer)
            ? "Diese Seriennummer ist einem anderen Kunden zugeordnet."
            : $"Diese Seriennummer ist dem Kunden {customer} zugeordnet.";
    }

    private void OnInsertClicked(MouseEventArgs args)
    {
        NavigationManager.NavigateTo("/Customers");
    }

    private void OnEditRowClicked(RepairOrderVm item)
    {
        Dispatcher.Dispatch(new SetCurrentRepairOrderAction(item));
        NavigationManager.NavigateTo($"/EditRepairOrder/{item.Id}");
    }

    /// <summary>
    /// Löscht einen Auftrag nach vorheriger Bestätigung durch den Benutzer. Der Aufruf ist
    /// zusätzlich zur Sichtbarkeit des Buttons auf die Benutzergruppe "admin" beschränkt.
    /// </summary>
    private async Task OnDeleteRowClicked(RepairOrderVm item)
    {
        if (!_isAdmin)
            return;

        var dialogResult = await DialogService.Confirm(
            $"Soll der Auftrag {item.Id} wirklich gelöscht werden?",
            "Auftrag löschen",
            new ConfirmOptions { OkButtonText = "Ja", CancelButtonText = "Nein" });
        if (dialogResult != true)
            return;

        var response = await RepairOrderService.DeleteAsync(item.Id, false);
        if (response.Success)
            await _grid.Reload();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        RepairOrderChangeSubscriber.Changed += OnRepairOrdersChanged;

        // Der Löschen-Button ist ausschließlich für die Benutzergruppe "admin" sichtbar.
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.Identity?.IsAuthenticated == true
            && authState.User.IsInRole(UserGroupRoles.Admin);
    }

    public void Dispose()
    {
        RepairOrderChangeSubscriber.Changed -= OnRepairOrdersChanged;
    }

    private async void OnRepairOrdersChanged(object? sender, RepairOrderChangedEvent changeEvent)
    {
        try
        {
            if (_grid is null)
                return;

            // Auf den Synchronisationskontext des eigenen Circuits marshallen und das Grid neu laden.
            await InvokeAsync(() => _grid.Reload());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "Fehler beim Aktualisieren der RepairOrder-Liste nach Änderung (Auftrag {RepairOrderId}).",
                changeEvent.RepairOrderId);
        }
    }
}
