@page "/RepairOrderStatusPage"


<InsertButton InsertClick="OnInsertClicked" />
<RadzenDataGrid @ref="_grid"
                TItem="RepairOrderStatusVm"
                Data="_data"
                LoadData="OnLoadData"
                IsLoading="_isLoading"
                Count="_totalCount"
                AllowPaging="true"
                PageSize="20"
                RowUpdate="OnRowUpdate"
                RowCreate="OnRowCreate"
                Density="Density.Compact" AllowColumnResize="true">
    <EmptyTemplate>
        <p style="color: lightgrey; font-size: 24px; text-align: center; margin: 2rem;">Keine Daten zum anzeigen vorhanden.</p>
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="RepairOrderStatusVm" Property="@nameof(RepairOrderStatusVm.Name)" Title="Name" MinWidth="200px">
            <EditTemplate Context="item">
                <RadzenTextBox @bind-Value="item.Name" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RepairOrderStatusVm" Property="@nameof(RepairOrderStatusVm.Description)" Title="Description" MinWidth="250px">
            <EditTemplate Context="item">
                <RadzenTextBox @bind-Value="item.Description" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RepairOrderStatusVm" Property="@nameof(RepairOrderStatusVm.BackgroundColor)" Title="Hintergrundfarbe" Width="120px">
            <Template Context="item">
                <div style="width:20px;height:20px;border-radius:50%;border:2px solid black;background-color:@item.BackgroundColor;display:inline-block;"></div>
            </Template>
            <EditTemplate Context="item">
                <RadzenColorPicker @bind-Value="item.BackgroundColor" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RepairOrderStatusVm" Property="@nameof(RepairOrderStatusVm.FontColor)" Title="Textfarbe" Width="120px">
            <Template Context="item">
                <div style="width:20px;height:20px;border-radius:50%;border:2px solid black;background-color:@item.FontColor;display:inline-block;"></div>
            </Template>
            <EditTemplate Context="item">
                <RadzenColorPicker @bind-Value="item.FontColor" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RepairOrderStatusVm" Title="Beispiel" Width="80px">
            <Template Context="item">
                <RadzenBadge Text="Text" IsPill="true" Style="@item.BadageStyle" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridInlineEditColumn TItem="RepairOrderStatusVm" EditRow="OnEditRowClicked" DeleteRow="OnDeleteRowClicked" CancelEditRow="OnCancelEditRowClicked" SaveRow="OnSaveRowClicked" />
    </Columns>
</RadzenDataGrid>

@code {
    [Inject] protected IRepairOrderStatusService RepairOrderStatusService { get; set; } = default!;
    [Inject] protected DialogService DialogService { get; set; } = default!;

    private RadzenDataGrid<RepairOrderStatusVm> _grid = default!;
    private IEnumerable<RepairOrderStatusVm>? _data;
    private int _totalCount;
    private bool _isLoading;

    private async Task OnLoadData(LoadDataArgs args)
    {
        _isLoading = true;
        var response = await RepairOrderStatusService.GetAllAsync(args);
        if (response.Success)
        {
            _data = response.Data?.Items;
            _totalCount = response.Data?.TotalCount ?? 0;
        }
        _isLoading = false;
    }

    private async Task OnInsertClicked(MouseEventArgs args)
    {
        if (!_grid.IsValid) return;
        var item = new RepairOrderStatusVm();
        await _grid.InsertRow(item);
    }

    private async Task OnRowUpdate(RepairOrderStatusVm item)
    {
        await RepairOrderStatusService.UpdateAsync(item.Id, item);
        await _grid.Reload();
    }

    private async Task OnRowCreate(RepairOrderStatusVm item)
    {
        await RepairOrderStatusService.CreateAsync(item);
        await _grid.Reload();
    }

    private async Task OnEditRowClicked(RepairOrderStatusVm item)
    {
        if (!_grid.IsValid) return;
        await _grid.EditRow(item);
    }

    private async Task OnDeleteRowClicked(RepairOrderStatusVm item)
    {
        var dialogResult = await DialogService.Confirm("Soll der Datensatz wirklich gelöscht werden?", "Datensatz löschen", new ConfirmOptions { OkButtonText = "Ja", CancelButtonText = "Nein" });
        if (dialogResult != true) return;

        await RepairOrderStatusService.DeleteAsync(item.Id);
        await _grid.Reload();
    }

    private async Task OnCancelEditRowClicked(RepairOrderStatusVm item)
    {
        _grid.CancelEditRow(item);
        await _grid.Reload();
    }

    private async Task OnSaveRowClicked(RepairOrderStatusVm item)
    {
        await _grid.UpdateRow(item);
    }
}
