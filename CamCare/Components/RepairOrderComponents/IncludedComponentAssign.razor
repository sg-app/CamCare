<RadzenDataGrid class="mt-2"
                @ref="_grid"
                Data="@RepairOrder.IncludedComponents"
                TItem="IncludedComponentVm"
                RowUpdate="OnRowUpdate"
                RowCreate="OnRowCreate"
                Density="Density.Compact"
                EmptyText="Keine Positionen eingetragen">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">

            <InsertIconButton Click="OnInsertClicked" />
            <RadzenText Text="Mitgelieferte Komponenten" TextStyle="TextStyle.H6" />
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="IncludedComponentVm" Title="Beschreibung">
            <Template Context="item">
                @item.Description
            </Template>
            <EditTemplate Context="item">

                <RadzenAutoComplete Value="@item.Description"
                                    Change="OnDescriptionChanged"
                                    Data=@_includedComponents
                                    LoadData="OnLoadDefectiveCatalog"
                                    OpenOnFocus="true"
                                    TextProperty="@nameof(IncludedComponentVm.Description)"
                                    Style="width: 100%"
                                    InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Artikel Katalog" }, { "onkeydown", "if(event.key==='Enter'){event.stopPropagation();event.preventDefault();}" } })" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridInlineEditColumn TItem="IncludedComponentVm" DeleteRow="OnDeleteRow" SaveRow="OnSaveRow" CancelEditRow="OnCancelEditRow" EditRow="OnEditRow" />
    </Columns>
</RadzenDataGrid>

@code {
    [Inject] protected ILogger<IncludedComponentAssign> Logger { get; set; } = default!;
    [Inject] protected IIncludedComponentService IncludedComponentService { get; set; } = default!;

    [Parameter] public RepairOrderVm RepairOrder { get; set; } = new();

    private IList<IncludedComponentVm>? _includedComponents;
    private RadzenDataGrid<IncludedComponentVm> _grid = default!;
    private IncludedComponentVm? _toEdit;

    private CancellationTokenSource? _defectiveChangedCts;
    private object? _lastDefectiveChangedValue;


    protected override Task OnParametersSetAsync()
    {
        if (RepairOrder is null)
            throw new ArgumentNullException(nameof(RepairOrder), "RepairOrder cannot be null");

        Logger.LogInformation("RepairOrder set to: {repairOrder}", RepairOrder);
        RepairOrder.Defectives ??= [];
        return base.OnParametersSetAsync();
    }

    private async Task OnLoadDefectiveCatalog(LoadDataArgs args)
    {
        Logger.LogTrace("Load included components catalog with Filter: {filter}", args.Filter);

        ServiceResponse<Paginated<IncludedComponentVm>> response;
        if (!string.IsNullOrEmpty(args.Filter))
            response = await IncludedComponentService.GetAllAsync(args, rp => rp.Description.ToLower().Contains(args.Filter.ToLower()));
        else
            response = await IncludedComponentService.GetAllAsync(args);

        _includedComponents = response.Data?.Items.ToList() ?? [];
    }

    private async Task OnDeleteRow(IncludedComponentVm item)
    {
        RepairOrder.IncludedComponents!.Remove(item);
        Logger.LogInformation("Position {item} deleted.", item);
        await _grid.Reload();
    }

    private async Task OnInsertClicked(MouseEventArgs args)
    {
        if (_toEdit is not null)
            return;

        Logger.LogInformation("New position added.");
        _toEdit = new IncludedComponentVm();
        await _grid.InsertRow(_toEdit);
    }

    private async Task OnSaveRow(IncludedComponentVm item)
    {
        await _grid.UpdateRow(item);
    }

    private async Task OnCancelEditRow(IncludedComponentVm item)
    {
        _toEdit = null;
        _grid.CancelEditRow(item);
        await _grid.Reload();
    }

    private async Task OnEditRow(IncludedComponentVm item)
    {
        _toEdit = item;
        await _grid.EditRow(item);
    }

    private Task OnRowCreate(IncludedComponentVm item)
    {
        Logger.LogInformation("Row created with {item}.", item);
        RepairOrder.IncludedComponents!.Add(item);
        _toEdit = null;
        return Task.CompletedTask;
    }

    private Task OnRowUpdate(IncludedComponentVm item)
    {
        _toEdit = null;
        return Task.CompletedTask;
    }

    private async Task OnDescriptionChanged(dynamic item)
    {
        _defectiveChangedCts?.Cancel();
        _defectiveChangedCts = new CancellationTokenSource();
        var token = _defectiveChangedCts.Token;
        _lastDefectiveChangedValue = item;
        Logger.LogDebug("Description changed to {item}.", _lastDefectiveChangedValue);
        try
        {
            await Task.Delay(200, token); // 200 ms warten
            if (!token.IsCancellationRequested)
            {
                var savedDefective = _includedComponents?.FirstOrDefault(d => d.Description == item?.ToString());
                _toEdit!.Id = savedDefective?.Id ?? 0;
                _toEdit!.Description = savedDefective?.Description ?? item.ToString();
                await _grid.UpdateRow(_toEdit);
            }
        }
        catch (TaskCanceledException)
        {
            // Ignorieren, weil ein neuer Wert kam
        }
    }

}
