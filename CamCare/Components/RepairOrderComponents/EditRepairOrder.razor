@page "/EditRepairOrder"
@page "/EditRepairOrder/{RepairOrderId:int}"
@attribute [Authorize]
@inherits FluxorComponent
@using CamCare.Models.Amicron
@using CamCare.Store.RepairOrderFeature

@if (RepairOrder is not null)
{
    <RadzenTemplateForm @ref="_form" Data="@RepairOrder" TItem="RepairOrderVm" Submit="OnSaveClicked"
                        InvalidSubmit="OnInvalidSubmit">
        <FluentValidator />
        <RadzenStack Orientation="Orientation.Horizontal">

            <RadzenFieldset Text="Kunde" class="w-50">
                <RadzenText>@RepairOrder.Customer?.KdNummer - @RepairOrder.Customer?.FullName</RadzenText>
                <RadzenText>@RepairOrder.Customer?.Plz @RepairOrder.Customer?.Ort</RadzenText>
            </RadzenFieldset>

            <RadzenFieldset Text="Reparaturgegenstand" class="w-50">
                <RadzenRadioButtonList TValue="bool?" Orientation="Orientation.Horizontal" Value="@RepairOrder.IsCamera"
                                       ValueChanged="@(args => OnItemTypeChanged(args))">
                    <Items>
                        <RadzenRadioButtonListItem Text="Mit Seriennummer" Value="true" />
                        <RadzenRadioButtonListItem Text="Einzelteil" Value="false" />
                        <RadzenRadioButtonListItem Text="Unbekannt" Value="@((bool?)null)" />
                    </Items>
                </RadzenRadioButtonList>

                @if (RepairOrder.IsCamera == true)
                {
                    <RadzenFormField class="d-block pt-2" Text="Seriennummer">
                        @if (_serialNotListed)
                        {
                            <RadzenTextBox @bind-Value="RepairOrder.CameraSerialNumber" Style="width:100%"
                                           Placeholder="Seriennummer manuell erfassen" />
                        }
                        else
                        {
                            <RadzenDropDown TValue="string" Value="@RepairOrder.CameraSerialNumber"
                                            ValueChanged="@(args => OnCameraSerialChanged(args))" Data="@_customerSerials"
                                            TextProperty="@nameof(Serials.DisplayName)" ValueProperty="@nameof(Serials.Seriennummer)"
                                            DisabledProperty="@nameof(Serials.HasOpenOrder)" AllowClear="true" AllowFiltering="true"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            FilterOperator="StringFilterOperator.Contains" AllowVirtualization="true"
                                            EmptyText="Keine Seriennummern für diesen Kunden gefunden" Style="width:100%" />
                        }
                    </RadzenFormField>

                    @if (_disabledSerialsCount > 0)
                    {
                        <RadzenText class="d-block text-secondary pt-1 pb-2">
                            @_disabledSerialsCount Seriennummer(n) sind deaktiviert, da für sie bereits ein anderer offener Auftrag
                            existiert.
                        </RadzenText>
                    }

                    @if (RepairOrder.SerialNumberNeedsMaintenance == true)
                    {
                        <RadzenText class="d-block text-danger pt-2">
                            Die Seriennummer ist nicht für den Kunden hinterlegt und muss von einem Mitarbeiter nachgepflegt werden.
                        </RadzenText>
                    }
                    <div class="pt-2">
                        <RadzenCheckBox TValue="bool" Value="@_serialNotListed"
                                        ValueChanged="@(args => OnSerialNotListedChanged(args))" Name="_serialNotListed" />
                        <RadzenLabel Text="Seriennummer nicht gelistet – Seriennummer manuell erfassen"
                                     Component="_serialNotListed" class="rz-ms-2" />
                    </div>
                }
                else if (RepairOrder.IsCamera == false)
                {
                    <RadzenFormField class="d-block pt-2" Text="Einzelteil Beschreibung" Style="width:100%">
                        <RadzenTextBox @bind-Value="RepairOrder.PiceOfEquipment" Style="width:100%" />
                    </RadzenFormField>
                }
                else
                {
                    <RadzenText class="d-block pt-2 text-secondary">
                        Bitte legen Sie fest, ob es sich um ein Gerät mit Seriennummer oder ein Einzelteil handelt.
                    </RadzenText>
                }
            </RadzenFieldset>
        </RadzenStack>

        <RadzenFieldset Text="Beschreibung" Visible="@(RepairOrder.CustomerId != null)">
            <RepairOrderDescription RepairOrder="@RepairOrder" />
            <EmployeeAssign RepairOrder="@RepairOrder" />
            <DefectiveAssign RepairOrder="@RepairOrder" />
            <WorkAssign RepairOrder="@RepairOrder" />
            <RepairPositionAssign RepairOrder="@RepairOrder" />
            <div class="d-flex flex-wrap gap-3">
                <div class="flex-grow-1" style="min-width: 320px;">
                    <DataAssign RepairOrder="@RepairOrder" />
                </div>
            </div>
        </RadzenFieldset>

        <FormButtons Class="pt-2" CancelClick="OnCancelClicked" />
    </RadzenTemplateForm>
}
else
{
    <RadzenText TextStyle="TextStyle.Body1">Lade Auftrag…</RadzenText>
}

@code {
    [Inject] protected IState<RepairOrderState> RepairOrderState { get; set; } = default!;

    [Inject] protected IRepairOrderService RepairOrderService { get; set; } = default!;
    [Inject] protected IAmicronDataService AmicronDataService { get; set; } = default!;
    [Inject] protected NavigationManager NavigationManager { get; set; } = default!;
    [Inject] protected IMasterdataService MasterdataService { get; set; } = default!;
    [Inject] protected NotificationService NotificationService { get; set; } = default!;
    [Inject] protected IDispatcher Dispatcher { get; set; } = default!;
    [Inject] protected IJSRuntime JS { get; set; } = default!;

    [Parameter] public int RepairOrderId { get; set; }

    private RepairOrderVm? RepairOrder => RepairOrderState.Value.CurrentRepairOrder;
    private IList<Serials> _customerSerials = new List<Serials>();
    private bool _serialNotListed;
    private int _disabledSerialsCount;
    private RadzenTemplateForm<RepairOrderVm> _form = default!;
    private bool _enterGuardAttached;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        // Die Enter-Taste in einem Formularfeld (z. B. "Beschreibung" in einer neu eingefügten
        // Grid-Zeile) löst sonst das implizite Absenden des RadzenTemplateForm aus:
        // Submit -> OnSaveClicked -> NavigateTo("/RepairOrders") – die Seite würde sich schließen.
        // Der Guard wird genau einmal pro Seite am <form>-Element aktiviert und unterdrückt nur
        // das implizite Submit (Enter in einem <input>), ohne Radzen-Listener zu beeinträchtigen.
        if (RepairOrder is not null && !_enterGuardAttached && !string.IsNullOrEmpty(_form?.Element.Id))
        {
            _enterGuardAttached = true;
            await JS.InvokeVoidAsync("camcarePreventImplicitFormSubmit", _form.Element);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        ArgumentNullException.ThrowIfNull(RepairOrderState);

        // Nach einem Hot Reload (oder direktem Aufruf / Refresh) ist der Fluxor-State
        // evtl. leer oder enthält einen anderen Auftrag → dann selbstständig laden.
        if (RepairOrderId > 0
            && (RepairOrderState.Value.CurrentRepairOrder is null
                || RepairOrderState.Value.CurrentRepairOrder.Id != RepairOrderId))
        {
            await LoadRepairOrderAsync(RepairOrderId);
        }

        if (RepairOrder is null)
            return;

        await LoadCustomerSerialsAsync();
        _serialNotListed = RepairOrder.SerialNumberNeedsMaintenance == true
            || (!string.IsNullOrEmpty(RepairOrder.CameraSerialNumber)
                && _customerSerials.All(s => s.Seriennummer != RepairOrder.CameraSerialNumber));
    }

    private async Task LoadRepairOrderAsync(int id)
    {
        var response = await RepairOrderService.GetByIdAsync(id);
        if (!response.Success || response.Data is null)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Auftrag nicht gefunden",
                Detail = response.Message ?? "Der Reparaturauftrag konnte nicht geladen werden.",
                Duration = 5000
            });
            NavigationManager.NavigateTo("/RepairOrders");
            return;
        }

        Dispatcher.Dispatch(new SetCurrentRepairOrderAction(response.Data));
    }

    private async Task LoadCustomerSerialsAsync()
    {
        if (RepairOrder is null || RepairOrder.CustomerId is not int customerId)
            return;

        var response = await AmicronDataService.GetSerialsFromCustomerIdAsync(customerId);
        if (response.Success)
        {
            var allSerials = response.Data ?? new List<Serials>();

            var openOrdersResponse = await RepairOrderService.GetOpenOrderSerialNumbersAsync();
            if (openOrdersResponse.Success && openOrdersResponse.Data is not null)
            {
                var currentSerial = RepairOrder.CameraSerialNumber?.Trim();

                foreach (var serial in allSerials)
                {
                    // Seriennummern mit offenem Auftrag werden über DisabledProperty deaktiviert,
                    // die aktuell diesem Auftrag zugeordnete Seriennummer bleibt auswählbar.
                    serial.HasOpenOrder = openOrdersResponse.Data.Contains(serial.Seriennummer?.Trim() ?? string.Empty)
                                          && serial.Seriennummer?.Trim() != currentSerial;
                }

                _disabledSerialsCount = allSerials.Count(s => s.HasOpenOrder);
            }

            _customerSerials = allSerials;
        }
    }

    private void OnItemTypeChanged(bool? isCamera)
    {
        if (RepairOrder.IsCamera == isCamera)
            return;

        RepairOrder.IsCamera = isCamera;
        RepairOrder.CameraSerialNumber = null;
        RepairOrder.Serials = null;
        RepairOrder.PiceOfEquipment = null;
        RepairOrder.SerialNumberNeedsMaintenance = false;
        _serialNotListed = false;
    }

    private void OnCameraSerialChanged(string? serialNumber)
    {
        RepairOrder.CameraSerialNumber = serialNumber;
        RepairOrder.Serials = _customerSerials.FirstOrDefault(s => s.Seriennummer == serialNumber);
        if (!string.IsNullOrEmpty(serialNumber))
        {
            RepairOrder.SerialNumberNeedsMaintenance = false;
            _serialNotListed = false;
        }
    }

    private void OnSerialNotListedChanged(bool isNotListed)
    {
        _serialNotListed = isNotListed;
        RepairOrder.CameraSerialNumber = null;
        RepairOrder.Serials = null;
        RepairOrder.SerialNumberNeedsMaintenance = isNotListed;
    }

    private void OnInvalidSubmit(FormInvalidSubmitEventArgs args)
    {
        var sb = new System.Text.StringBuilder();
        var errors = args.Errors?.ToList() ?? [];
        foreach (var message in errors)
        {
            sb.AppendLine(message);
        }

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Fehler",
            DetailContent = ns => builder =>
            {
                var seq = 0;
                builder.OpenElement(seq++, "div");

                builder.OpenElement(seq++, "strong");
                builder.AddContent(seq++, "Aufgrund fehlerhaften Eingaben kann nicht gespeichert werden.");
                builder.CloseElement(); // strong

                builder.OpenElement(seq++, "ul");
                foreach (var message in errors)
                {
                    builder.OpenElement(seq++, "li");
                    builder.AddContent(seq++, message);
                    builder.CloseElement(); // li
                }
                builder.CloseElement(); // ul

                builder.CloseElement(); // div
            },
            Duration = 7000
        });
    }

    private async Task OnSaveClicked(RepairOrderVm item)
    {
        var response = await RepairOrderService.UpdateAsync(RepairOrder.Id, RepairOrder);
        if (response.Success)
        {
            NavigationManager.NavigateTo("/RepairOrders");
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Fehler",
                Detail = response.Message ?? "Unbekannter Fehler",
                Duration = 5000
            });
        }
    }

    private void OnCancelClicked(MouseEventArgs args)
    {
        NavigationManager.NavigateTo("/RepairOrders");
    }


}
