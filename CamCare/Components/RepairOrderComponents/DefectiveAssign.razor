@* Zuordnung der Defekte eines Reparaturauftrags.
   Statt eines Grids wird ein AutoComplete verwendet: Der Defekt wird gesucht oder frei erfasst
   und mit Enter bzw. „Einfügen“ ans Ende der Liste gehängt. Die Reihenfolge wird am Auftrag
   gespeichert (SortOrder) und kann per Drag&Drop geändert werden. *@
@inherits AssignmentListComponentBase<DefectiveVm>

<div class="mt-2" data-assignment="Defekte">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <InsertIconButton Click="OnInsertClicked" />
        <RadzenText Text="Defekte" TextStyle="TextStyle.H6" />
    </RadzenStack>

    <RadzenAutoComplete class="mt-2" TValue="string" Value="@SearchText" ValueChanged="@OnSearchTextChanged"
                        Change="@(value => OnSearchTextChanged(value?.ToString()))" SelectedItemChanged="@OnCatalogItemSelected"
                        Data="@Catalog" LoadData="@OnLoadCatalog" OpenOnFocus="true" TextProperty="@nameof(DefectiveVm.Description)"
                        Placeholder="Defekt suchen oder neu erfassen – Enter oder Einfügen übernimmt den Eintrag" Style="width:100%"
                        @onkeydown="OnSearchKeyDown"
                        InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Defekt Katalog" } })" />

    @if (Items is null || Items.Count == 0)
    {
        <RadzenText class="d-block text-secondary pt-1">Keine Positionen eingetragen</RadzenText>
    }
    else
    {
        var position = 0;
        @foreach (var item in Items)
        {
            var index = position;
            position++;

            <div @key="item" class="camcare-assignment-row d-flex align-items-center gap-2 @GetRowClass(index)" draggable="true"
                 title="Ziehen, um die Reihenfolge zu ändern" @ondragstart="() => OnDragStart(index)" @ondragover:preventDefault
                 @ondragover="() => OnDragOver(index)" @ondrop:preventDefault @ondrop="() => OnDrop(index)"
                 @ondragend="OnDragEnd">
                <RadzenIcon Icon="drag_indicator" class="text-secondary" />

                <div class="flex-grow-1">
                    <RadzenText class="d-block">@item.Description</RadzenText>
                </div>

                <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger"
                              Click="() => OnRemoveClicked(item)" />
            </div>
        }
    }
</div>

@code {
    [Inject] protected IDefectiveService DefectiveService { get; set; } = default!;

    protected override ICollection<DefectiveVm>? Items
    {
        get => RepairOrder.Defectives;
        set => RepairOrder.Defectives = value;
    }

    protected override string GetDescription(DefectiveVm item) => item.Description;

    protected override int GetSortOrder(DefectiveVm item) => item.SortOrder;

    protected override void SetSortOrder(DefectiveVm item, int sortOrder) => item.SortOrder = sortOrder;

    protected override DefectiveVm CreateFromText(string text) => new() { Description = text };

    protected override DefectiveVm CreateFromCatalogItem(DefectiveVm catalogItem)
        => new() { Id = catalogItem.Id, Description = catalogItem.Description };

    /// <summary>Lädt die Katalogtreffer für die Suche im AutoComplete.</summary>
    private async Task OnLoadCatalog(LoadDataArgs args)
    {
        Logger.LogTrace("Defekt-Katalog laden (Filter: {filter}).", args.Filter);

        ServiceResponse<Paginated<DefectiveVm>> response;
        if (!string.IsNullOrEmpty(args.Filter))
            response = await DefectiveService.GetAllAsync(args, d => d.Description.ToLower().Contains(args.Filter.ToLower()));
        else
            response = await DefectiveService.GetAllAsync(args);

        Catalog = response.Data?.Items.ToList() ?? [];
    }
}
