<RadzenDataGrid class="mt-2" @ref="_grid" Data="@RepairOrder.Defectives" TItem="DefectiveVm" RowUpdate="OnRowUpdate"
                RowCreate="OnRowCreate" Density="Density.Compact" EmptyText="Keine Positionen eingetragen">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">

            <InsertIconButton Click="OnInsertClicked" />
            <RadzenText Text="Defekte" TextStyle="TextStyle.H6" />
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="DefectiveVm" Title="Beschreibung">
            <Template Context="item">
                @item.Description
            </Template>
            <EditTemplate Context="item">

                <RadzenAutoComplete @onkeydown="(args) => OnEditKeyDown(args, item)" Value="@item.Description" Change="OnDescriptionChanged" Data=@_defectives
                                    LoadData="OnLoadDefectiveCatalog" OpenOnFocus="true" TextProperty="@nameof(DefectiveVm.Description)"
                                    ValueChanged="@(value => OnValueChanged(item, value))" SelectedItemChanged="OnSelectedItemChanged"
                                    Style="width: 100%"
                                    InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Artikel Katalog" } })" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridInlineEditColumn TItem="DefectiveVm" DeleteRow="OnDeleteRow" SaveRow="OnSaveRow"
                                        CancelEditRow="OnCancelEditRow" EditRow="OnEditRow" />
    </Columns>
</RadzenDataGrid>

@code {
    [Inject] protected ILogger<DefectiveAssign> Logger { get; set; } = default!;
    [Inject] protected IDefectiveService DefectiveService { get; set; } = default!;
    [Inject] protected IJSRuntime JS { get; set; } = default!;

    [Parameter] public RepairOrderVm RepairOrder { get; set; } = new();

    private IList<DefectiveVm>? _defectives;
    private RadzenDataGrid<DefectiveVm> _grid = default!;
    private DefectiveVm? _toEdit;
    private DefectiveVm? _toCreate;


    protected override Task OnParametersSetAsync()
    {
        if (RepairOrder is null)
            throw new ArgumentNullException(nameof(RepairOrder), "RepairOrder cannot be null");

        Logger.LogInformation("RepairOrder set to: {repairOrder}", RepairOrder);
        RepairOrder.Defectives ??= [];
        return base.OnParametersSetAsync();
    }

    private async Task OnLoadDefectiveCatalog(LoadDataArgs args)
    {
        Logger.LogTrace("Load defects catalog with Filter: {filter}", args.Filter);

        ServiceResponse<Paginated<DefectiveVm>> response;
        if (!string.IsNullOrEmpty(args.Filter))
            response = await DefectiveService.GetAllAsync(args, rp => rp.Description.ToLower().Contains(args.Filter.ToLower()));
        else
            response = await DefectiveService.GetAllAsync(args);

        _defectives = response.Data?.Items.ToList() ?? [];
    }

    private async Task OnDeleteRow(DefectiveVm item)
    {
        RepairOrder.Defectives!.Remove(item);
        Logger.LogInformation("Position {item} deleted.", item);
        await _grid.Reload();
    }

    private async Task OnInsertClicked(MouseEventArgs args)
    {
        if (_toEdit is not null)
            return;

        Logger.LogInformation("New position added.");
        _toEdit = new DefectiveVm();

        // Neue Zeilen werden ans Ende der Liste gehängt (Append) statt an erster Stelle eingefügt.
        await _grid.AppendRowAsync(_toEdit);
    }

    private async Task OnSaveRow(DefectiveVm item)
    {
        await _grid.UpdateRow(item);
    }

    private async Task OnEditKeyDown(KeyboardEventArgs args, DefectiveVm item)
    {
        if (args.Key != "Enter")
            return;

        // Das change-Event des RadzenAutoComplete (ValueChanged -> Modellbindung) feuert bei
        // Enter noch nicht – erst beim Verlassen des Felds (Blur). Damit die Eingabe übernommen
        // wird, lesen wir den aktuellen Wert direkt aus dem fokussierten Input und aktualisieren
        // das Modell, BEVOR die Zeile gespeichert wird.
        var value = await JS.InvokeAsync<string>("camcareGetActiveElementValue");
        OnDescriptionChanged(value);

        // Wurde die Zeile bereits über die Dropdown-Auswahl (OnSelectedItemChanged) gespeichert,
        // ist _toEdit null und es ist hier nichts mehr zu tun.
        if (_toEdit is not null)
        {
            await OnSaveRow(item);
        }
    }

    private async Task OnCancelEditRow(DefectiveVm item)
    {
        _toEdit = null;
        _toCreate = null;
        _grid.CancelEditRow(item);
        await _grid.Reload();
    }

    private async Task OnEditRow(DefectiveVm item)
    {
        _toEdit = item;
        await _grid.EditRow(item);
    }

    private Task OnRowCreate(DefectiveVm item)
    {
        Logger.LogInformation("Row created with {item}.", item);
        RepairOrder.Defectives!.Add(item);
        _toCreate = item;
        _toEdit = null;
        return Task.CompletedTask;
    }

    private Task OnRowUpdate(DefectiveVm item)
    {
        _toEdit = null;
        return Task.CompletedTask;
    }

    private static void OnValueChanged(DefectiveVm item, string? value)
        => item.Description = value ?? string.Empty;

    private void OnDescriptionChanged(dynamic item)
    {
        Logger.LogDebug("Description changed to {item}.", item as string);

        if (_toEdit is null)
            return;

        // Beim Verlassen des Felds (Enter/Blur) wird hier nur das Modell aktualisiert –
        // KEIN `UpdateRow`, damit ein anschließendes `click`-Event (Auswahl per Maus)
        // verarbeitet werden kann, bevor die Zelle geschlossen wird.
        var text = item?.ToString() ?? string.Empty;
        var savedDefective = _defectives?.FirstOrDefault(d => d.Description == text);
        _toEdit.Id = savedDefective?.Id ?? 0;
        _toEdit.Description = savedDefective?.Description ?? text;
    }

    private async Task OnSelectedItemChanged(object? selected)
    {
        if (selected is not DefectiveVm selectedDefective || _toEdit is null)
            return;

        Logger.LogDebug("Defective '{description}' selected from catalog.", selectedDefective.Description);
        _toEdit.Id = selectedDefective.Id;
        _toEdit.Description = selectedDefective.Description;
        await _grid.UpdateRow(_toEdit);
    }

}
