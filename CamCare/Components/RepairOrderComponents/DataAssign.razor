﻿<style>
    #uploadWithDragAndDrop {
        left: 0;
        --rz-upload-button-bar-background-color: transparent;
        --rz-upload-button-bar-padding: 0;
    }

    #uploadWithDragAndDrop .rz-fileupload-buttonbar .rz-fileupload-choose {
        width: 100%;
        text-align: center;
        font-size: 16px;
        padding: 40px 0;
    }

    .rz-datalist-content .rz-g>div,
    .rz-datalist-data>li {
        border: none;
    }
</style>

<RadzenCard class="mt-2">
    <RadzenText TextStyle="TextStyle.H6">Dateiupload</RadzenText>
    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H6">Bilder, PDF- und Videodateien (z. B. MP4) mit
        maximal @MaxFileSizeMb MB oder Mobiler upload durch scannen von QR-Code gültig bis
        @_qrCodeGenerated?.AddMinutes(UploadLinkLifetimeMinutes).ToShortTimeString()

    </RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal">

        <div id="uploadWithDragAndDrop" class="rz-fileupload" style="width:100%">
            <div class="rz-fileupload-buttonbar">
                <span class="rz-fileupload-choose rz-button">
                    <text>
                        <InputFile @key="@_inputFieldKey" class="form-control" id="inputGroupFile01" @ref="inputFile"
                                   multiple="true" accept="image/*,application/pdf,video/*" OnChange="@OnChange" />
                        <span class="rz-button-text">Drag and drop here or click to choose files</span>
                    </text>
                </span>
            </div>
        </div>
        <div>
            @if (RepairOrder.Id > 0)
            {
                <div>
                    <div id="uploadQrCode"></div>
                    <div class="mt-2 d-flex gap-2">
                        <RadzenButton Text="Erneuern" ButtonStyle="ButtonStyle.Light" Icon="refresh"
                                      Click="OnGenerateUploadLinkClicked" />
                    </div>
                </div>
            }
        </div>
    </RadzenStack>
    <RadzenDataList TItem="DataStoreVm" Data="@RepairOrder.DataStores" WrapItems="true" Density="Density.Compact">
        <Template Context="item">
            <div class="d-flex flex-column justify-content-center">
                <div class="align-self-center">
                    @if (!string.IsNullOrWhiteSpace(item.DownloadUrl) && item.Type.StartsWith("image",
                    StringComparison.OrdinalIgnoreCase))
                    {
                        <RadzenImage class="m-2" Path="@item.DownloadUrl" Style="width: 15rem;" />
                    }
                    else if (!string.IsNullOrWhiteSpace(item.DownloadUrl) && item.Type.Equals("application/pdf",
                    StringComparison.OrdinalIgnoreCase))
                    {
                        <iframe class="m-2" style="width: 15rem; height: 20rem; border: 1px solid #ccc;"
                                src="@item.DownloadUrl" title="PDF Preview"></iframe>
                    }
                    else if (!string.IsNullOrWhiteSpace(item.DownloadUrl) && item.Type.StartsWith("video/",
                    StringComparison.OrdinalIgnoreCase))
                    {
                        <video class="m-2" style="width: 15rem;" controls preload="metadata" src="@item.DownloadUrl"
                               title="Video Preview"></video>
                    }
                    else if (item.Data is not null && item.Type.StartsWith("image", StringComparison.OrdinalIgnoreCase))
                    {
                        <RadzenImage class="m-2" Path="@($"data:{item.Type};base64,{Convert.ToBase64String(item.Data)}")"
                                     Style="width: 15rem;" />
                    }
                    else if (item.Data is not null && item.Type.Equals("application/pdf",
                    StringComparison.OrdinalIgnoreCase))
                    {
                        <iframe class="m-2" style="width: 15rem; height: 20rem; border: 1px solid #ccc;"
                                src="@($"data:application/pdf;base64,{Convert.ToBase64String(item.Data)}")"
                                title="PDF Preview"></iframe>
                    }
                    else if (item.Data is not null && item.Type.StartsWith("video/",
                    StringComparison.OrdinalIgnoreCase))
                    {
                        <video class="m-2" style="width: 15rem;" controls preload="metadata"
                               src="@($"data:{item.Type};base64,{Convert.ToBase64String(item.Data)}")"
                               title="Video Preview"></video>
                    }
                    else
                    {
                        <RadzenText class="m-2">Keine Vorschau verfügbar</RadzenText>
                    }
                </div>
                <div class="align-self-center">
                    <RadzenButton Icon="download" Click="@(() => OnDownloadClicked(item))" Size="ButtonSize.Small" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                  Click="@(() => OnDeleteClicked(item))" />
                </div>
                <div class="align-self-center">
                    <RadzenText class="text-wrap text-break">@item.Filename</RadzenText>
                </div>
            </div>
        </Template>
    </RadzenDataList>
</RadzenCard>


@code {
    [Inject] protected ILogger<DataAssign> Logger { get; set; } = default!;
    [Inject] protected DialogService DialogService { get; set; } = default!;
    [Inject] protected IDataStoreService DataStoreService { get; set; } = default!;
    [Inject] protected IOptions<ObjectStorageOptions> ObjectStorageOptions { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] protected IOptions<UploadLinkOptions> UploadLinkOptions { get; set; } = default!;
    [Inject] protected IUploadTokenService UploadTokenService { get; set; } = default!;
    [Inject] protected NotificationService NotificationService { get; set; } = default!;
    [Inject] protected NavigationManager NavigationManager { get; set; } = default!;

    private long MaxFileSizeBytes => ObjectStorageOptions.Value.MaxFileSizeBytes;
    private long MaxFileSizeMb => MaxFileSizeBytes / (1024 * 1024);

    [Parameter] public RepairOrderVm RepairOrder { get; set; } = new();

    private InputFile inputFile = default!;
    private Guid _inputFieldKey = Guid.NewGuid();
    private int UploadLinkLifetimeMinutes => UploadLinkOptions.Value.TokenLifetimeMinutes;
    private string? _uploadUrl;
    private DateTime? _qrCodeGenerated;

    protected override async Task OnParametersSetAsync()
    {
        if (RepairOrder is null)
            throw new ArgumentNullException(nameof(RepairOrder), "RepairOrder cannot be null");

        Logger.LogInformation("RepairOrder set to: {repairOrder}", RepairOrder);
        var response = await DataStoreService.GetFromRepairOrderAsync(RepairOrder.Id);
        RepairOrder.DataStores = response.Data;
        RepairOrder.DataStores ??= [];
        await OnGenerateUploadLinkClicked(default!);
        await base.OnParametersSetAsync();
    }

    private async Task OnDeleteClicked(DataStoreVm item)
    {
        var toDelete = RepairOrder.DataStores!.FirstOrDefault(f => f.Id == item.Id);
        if (toDelete is null)
            return;

        var dialogResult = await DialogService.Confirm("Soll die Datei wirklich gelöscht werden?", "Datensatz löschen", new
ConfirmOptions
        { OkButtonText = "Ja", CancelButtonText = "Nein" });
        if (dialogResult != true) return;

        var response = await DataStoreService.DeleteAsync(toDelete.Id, false);
        if (!response.Success) return;

        RepairOrder.DataStores!.Remove(toDelete);
    }

    private async Task OnChange(InputFileChangeEventArgs args)
    {
        RepairOrder.DataStores ??= [];
        var files = args.GetMultipleFiles();
        foreach (var file in files)
        {
            try
            {
                if (!IsSupportedContentType(file.ContentType))
                {
                    await DialogService.Alert("Nur Bild-, PDF- und Videodateien sind erlaubt.", "Ungültiger Dateityp");
                    continue;
                }

                await using var stream = file.OpenReadStream(MaxFileSizeBytes);
                using var mStream = new MemoryStream();
                await stream.CopyToAsync(mStream);
                var data = mStream.ToArray();

                var item = new DataStoreVm
                {
                    RepairOrderId = RepairOrder.Id,
                    Type = file.ContentType,
                    Filename = file.Name,
                    Data = data,
                    SizeBytes = data.LongLength
                };

                var response = await DataStoreService.CreateAsync(item);
                if (response.Success && response.Data is not null)
                    RepairOrder.DataStores.Add(response.Data);

                Logger.LogDebug("Uploaded: {FileName} / {Size} bytes", file.Name, file.Size);
            }
            catch (IOException)
            {
                await DialogService.Alert($"Datei ist größer als {MaxFileSizeMb}MB und konnte nicht hochgeladen werden.", "Datei zu groß");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Fehler beim Upload von {FileName}", file.Name);
                await DialogService.Alert("Datei konnte nicht hochgeladen werden.", "Upload fehlgeschlagen");
            }
        }
    }

    private bool IsSupportedContentType(string contentType)
    {
        if (string.IsNullOrWhiteSpace(contentType))
            return false;

        return contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)
               || contentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase)
               || contentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase);
    }

    private async Task OnDownloadClicked(DataStoreVm item)
    {
        if (!string.IsNullOrWhiteSpace(item.DownloadUrl))
        {
            var separator = item.DownloadUrl.Contains('?') ? "&" : "?";
            await JS.InvokeVoidAsync("open", $"{item.DownloadUrl}{separator}download=true", "_blank");
            return;
        }

        if (item.Data is not null)
        {
            await JS.InvokeVoidAsync("downloadFileFromByteArray", item.Filename, item.Data);
        }
    }
    private async Task OnGenerateUploadLinkClicked(MouseEventArgs args)
    {
        if (RepairOrder is null || RepairOrder.Id <= 0)
            return;

        // Neuen Link erzeugen und QR-Code aktualisieren.
        _uploadUrl = BuildUploadUrl();
        StateHasChanged();
        await Task.Yield();
        await RenderQrCodeAsync();
    }

    private string BuildUploadUrl()
    {
        if (RepairOrder is null || RepairOrder.Id <= 0)
            return string.Empty;

        var token = UploadTokenService.CreateToken(RepairOrder.Id);
        return $"{UploadLinkOptions.Value.PublicBaseUrl}/u/{token}";
    }

    private async Task RenderQrCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_uploadUrl))
            return;

        await JS.InvokeVoidAsync("renderQrCode", "uploadQrCode", _uploadUrl);
        _qrCodeGenerated = DateTime.Now;
        await InvokeAsync(StateHasChanged);
    }
}
