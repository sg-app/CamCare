@using CamCare.Models.Amicron

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
        <RadzenFormField Text="Kamera wählen">
            <RadzenDropDown @ref="@_dropDown"
                            TValue="string"
                            Value="Value"
                            ValueChanged="OnValueChanged"
                            Data="_serialnumbers"
                            LoadData="OnCameraLoadData"
                            Count="_totalCountCameras"
                            TextProperty="@nameof(Serials.DisplayName)"
                            ValueProperty="@nameof(Serials.Seriennummer)"
                            AllowVirtualization="true"
                            AllowClear="true"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            FilterOperator="StringFilterOperator.Contains"
                            Style="width:500px"
                            Disabled="IsEditMode"/>
        </RadzenFormField>
    </RadzenStack>

@code {
    [Inject] protected ILogger<AmicronCameraAssign> Logger { get; set; } = default!;
    [Inject] protected IAmicronDataService AmicronDataService { get; set; } = default!;

    [Parameter] public int? CustomerId { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool IsEditMode { get; set; }

    private RadzenDropDown<string> _dropDown = default!;
    private IEnumerable<Serials>? _serialnumbers;
    private int _totalCountCameras;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await OnCameraLoadData(new() { Top = 9 });
    }

    private async Task OnCameraLoadData(LoadDataArgs args)
    {
        if(CustomerId is null)
            return; 

        var response = await AmicronDataService.GetSerialsFromCustomerIdAsync(args, CustomerId.Value);

        if (response.Success)
        {
            _serialnumbers = response.Data?.Items;
            _totalCountCameras = response.Data?.TotalCount ?? 0;
        }
    }

    private async Task OnValueChanged(string serialNumber)
    {
        Value = serialNumber;
        await ValueChanged.InvokeAsync(serialNumber);
    }
}
