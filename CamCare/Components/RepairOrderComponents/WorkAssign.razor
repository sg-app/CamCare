@* Zuordnung der ausgeführten Arbeiten eines Reparaturauftrags.
   Statt eines Grids wird ein AutoComplete verwendet: Die Arbeit wird gesucht oder frei erfasst
   und mit Enter bzw. „Einfügen“ ans Ende der Liste gehängt. Die Reihenfolge wird am Auftrag
   gespeichert (SortOrder) und kann per Drag&Drop geändert werden. *@
@inherits AssignmentListComponentBase<WorkVm>

<div class="mt-2" data-assignment="Arbeiten" @ref="Container">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <InsertIconButton Click="OnInsertClicked" />
        <RadzenText Text="Ausgeführte Arbeiten" TextStyle="TextStyle.H6" />
    </RadzenStack>

    <RadzenAutoComplete class="mt-2" TValue="string" Value="@SearchText" ValueChanged="@OnSearchTextChanged"
                        Change="@(value => OnSearchTextChanged(value?.ToString()))" SelectedItemChanged="@OnCatalogItemSelected"
                        Data="@Catalog" LoadData="@OnLoadCatalog" OpenOnFocus="true" TextProperty="@nameof(WorkVm.Description)"
                        Placeholder="Arbeit suchen oder neu erfassen – Enter oder Einfügen übernimmt den Eintrag" Style="width:100%"
                        @onkeydown="OnSearchKeyDown"
                        InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Arbeiten Katalog" } })" />

    @if (Items is null || Items.Count == 0)
    {
        <RadzenText class="d-block text-secondary pt-1">Keine Positionen eingetragen</RadzenText>
    }
    else
    {
        var position = 0;
        @foreach (var item in Items)
        {
            var index = position;
            position++;

            <div @key="item" class="camcare-assignment-row d-flex align-items-center gap-2 @GetRowClass(index)" draggable="true"
                 title="Ziehen, um die Reihenfolge zu ändern" @ondragstart="() => OnDragStart(index)" @ondragover:preventDefault
                 @ondragover="() => OnDragOver(index)" @ondrop:preventDefault @ondrop="() => OnDrop(index)"
                 @ondragend="OnDragEnd">
                <RadzenIcon Icon="drag_indicator" class="text-secondary" />
                <div class="flex-grow-1">
                    <RadzenText class="d-block">@item.Description</RadzenText>
                </div>
                <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger"
                              Click="() => OnRemoveClicked(item)" />
            </div>
        }
    }
</div>

@code {
    [Inject] protected IWorkService WorkService { get; set; } = default!;

    protected override ICollection<WorkVm>? Items
    {
        get => RepairOrder.Works;
        set => RepairOrder.Works = value;
    }

    protected override string GetDescription(WorkVm item) => item.Description;

    protected override int GetSortOrder(WorkVm item) => item.SortOrder;

    protected override void SetSortOrder(WorkVm item, int sortOrder) => item.SortOrder = sortOrder;

    protected override WorkVm CreateFromText(string text) => new() { Description = text };

    protected override WorkVm CreateFromCatalogItem(WorkVm catalogItem)
        => new() { Id = catalogItem.Id, Description = catalogItem.Description };

    /// <summary>Lädt die Katalogtreffer für die Suche im AutoComplete.</summary>
    private async Task OnLoadCatalog(LoadDataArgs args)
    {
        Logger.LogTrace("Arbeiten-Katalog laden (Filter: {filter}).", args.Filter);

        ServiceResponse<Paginated<WorkVm>> response;
        if (!string.IsNullOrEmpty(args.Filter))
            response = await WorkService.GetAllAsync(args, w => w.Description.ToLower().Contains(args.Filter.ToLower()));
        else
            response = await WorkService.GetAllAsync(args);

        Catalog = response.Data?.Items.ToList() ?? [];
    }
}
