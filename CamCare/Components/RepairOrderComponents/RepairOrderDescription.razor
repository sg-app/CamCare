<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenFormField class="d-block pt-2" Text="Eingetroffen">
        <RadzenDatePicker @bind-Value="RepairOrder.ArrivedAt" ShowTime="true" DateFormat="dd.MM.yyyy HH:mm" />
    </RadzenFormField>
    <RadzenFormField class="d-block pt-2" Text="Auftragsnummer">
        <RadzenTextBox @bind-Value="RepairOrder.OrderNumber" />
    </RadzenFormField>
</RadzenStack>
<RadzenStack Orientation="Orientation.Horizontal" class="pt-2">
    <RadzenLabel Text="Prioritätsreparatur" Component="Priority" />
    <RadzenCheckBox @bind-Value="RepairOrder.PriorityRepair" Name="Priority" />
</RadzenStack>
<RadzenFormField class="d-block pt-2" Text="Kundenbemerkung">
    <RadzenTextArea @bind-Value="RepairOrder.CustomerDescription" Rows="2" Cols="100" />
</RadzenFormField>
<RadzenFormField class="pt-2" Text="Status">
    <RadzenDropDown @bind-Value="RepairOrder.RepairOrderStatusId" Data="@(MasterdataService.Get<RepairOrderStatusVm>())"
                    AllowFiltering="true" AllowVirtualization="true" TextProperty="@nameof(RepairOrderStatusVm.Name)"
                    ValueProperty="@nameof(RepairOrderStatusVm.Id)" AllowClear="true" Style="width:500px" />
</RadzenFormField>
<RadzenRadioButtonList class="pt-2" @bind-Value="RepairOrder.ShippingMethod">
    <Items>
        <RadzenRadioButtonListItem Text="@ShippingMethod.PickedUp.GetDisplayDescription()"
                                   Value="ShippingMethod.PickedUp" />
        <RadzenRadioButtonListItem Text="@ShippingMethod.SentByCustomer.GetDisplayDescription()"
                                   Value="ShippingMethod.SentByCustomer" />
        <RadzenRadioButtonListItem Text="@ShippingMethod.BroughtByCustomer.GetDisplayDescription()"
                                   Value="ShippingMethod.BroughtByCustomer" />
    </Items>
</RadzenRadioButtonList>

@if (RepairOrder.ShippingMethod == ShippingMethod.PickedUp)
{
    <LogisticProviderAssign RepairOrder="@RepairOrder" />
}

<RadzenFormField class="d-block pt-2" Text="Versandbemerkung">
    <RadzenTextArea @bind-Value="RepairOrder.ShippingMethodDescription" Rows="2" Cols="100" />
</RadzenFormField>

<RadzenRadioButtonList class="pt-2" @bind-Value="RepairOrder.PackagingType">
    <Items>
        <RadzenRadioButtonListItem Text="@PackagingType.CustomersBox.GetDisplayDescription()"
                                   Value="PackagingType.CustomersBox" />
        <RadzenRadioButtonListItem Text="@PackagingType.NewBox.GetDisplayDescription()" Value="PackagingType.NewBox" />
        <RadzenRadioButtonListItem Text="@PackagingType.Pallet.GetDisplayDescription()" Value="PackagingType.Pallet" />
    </Items>
</RadzenRadioButtonList>
@if (RepairOrder.PackagingType == PackagingType.CustomersBox || RepairOrder.PackagingType == PackagingType.Pallet)
{
    <div>
        <RadzenLabel Text="Kartonmaße in cm (L x B x H)" class="pe-2" />
        <RadzenNumeric @bind-Value="RepairOrder.PackagingLength" Style="width:100px" />
        <RadzenNumeric @bind-Value="RepairOrder.PackagingHeight" Style="width:100px" />
        <RadzenNumeric @bind-Value="RepairOrder.PackagingWidth" Style="width:100px" />
    </div>
}
<RadzenFormField class="d-block" Text="Verpackungsbemerkung">
    <RadzenTextArea @bind-Value="RepairOrder.PackagingComment" Rows="2" Cols="100" />
</RadzenFormField>
<IncludedComponentAssign RepairOrder="@RepairOrder" />

@code {
    [Inject] protected IMasterdataService MasterdataService { get; set; } = default!;

    [Parameter] public RepairOrderVm RepairOrder { get; set; } = default!;
}
