@if (CustomerId != null)
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
        <RadzenFormField Text="Kamera wählen">
            <RadzenDropDown @ref="@_dropDown"
                TValue="string"
                            Value="Value"
                            ValueChanged="OnValueChanged"
                            Data="_cameras"
                            LoadData="OnCameraLoadData"
                            Count="_totalCountCameras"
                            TextProperty="@nameof(CameraVm.DisplayName)"
                            ValueProperty="@nameof(CameraVm.SerialNumber)"
                            AllowVirtualization="true"
                            AllowClear="true"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            FilterOperator="StringFilterOperator.Contains"
                            Style="width:500px" />
        </RadzenFormField>
        <InsertIconButton Class="mt-2" Size="ButtonSize.Medium" Click="@(() => _createCamera = true)" />
    </RadzenStack>
    @if (_createCamera)
    {
        <CameraEdit CustomerId="@CustomerId" ValueChanged="OnCameraCreated" CancelEdit="OnCancelCameraEdit" />
    }
}
@code {
    [Inject] protected ICameraService CameraService { get; set; } = default!;
    [Inject] protected ILogger<CameraAssign> Logger { get; set; } = default!;

    [Parameter] public string CustomerId { get; set; }
    [Parameter] public string Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private RadzenDropDown<string> _dropDown = default!;
    private IEnumerable<CameraVm>? _cameras;
    private int _totalCountCameras;
    private bool _createCamera;

    private async Task OnCameraLoadData(LoadDataArgs args)
    {
        ServiceResponse<Paginated<CameraVm>> response;

        if (string.IsNullOrEmpty(args.Filter))
            response = await CameraService.GetAllAsync(args, cam => cam.CustomerId == CustomerId);
        else
            response = await CameraService.GetAllAsync(args, cam => cam.SerialNumber.Contains(args.Filter) || cam.CameraType.Name.Contains(args.Filter));

        if (response.Success)
        {
            _cameras = response.Data?.Items;
            _totalCountCameras = response.Data?.TotalCount ?? 0;
        }
    }

    private async Task OnCameraCreated(CameraVm args)
    {
        await OnCameraLoadData(new LoadDataArgs { Filter = args.SerialNumber });
        var serialNumber = _cameras?.FirstOrDefault(x => x.SerialNumber == args.SerialNumber)?.SerialNumber ?? string.Empty;
        _createCamera = false;
        await OnValueChanged(serialNumber);
    }
    private void OnCancelCameraEdit(MouseEventArgs args)
    {
        _createCamera = false;
    }

    private async Task OnValueChanged(string serialNumber)
    {
        Value = serialNumber;
        await ValueChanged.InvokeAsync(serialNumber);
    }
}
