@using CamCare.Models.Amicron
@using CamCare.Services
<RadzenRow>
    <RadzenColumn>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenFormField Text="Kunde wählen">
                <RadzenDropDown TValue="int?"
                                Value="@Value"
                                ValueChanged="OnValueChanged"
                                Data="_customers"
                                LoadData="OnCustomerLoadData"
                                Count="_totalCountCustomers"
                                TextProperty="@nameof(Adressen.DisplayName)"
                                ValueProperty="@nameof(Adressen.LfdNr)"
                                AllowVirtualization="true"
                                AllowClear="true"
                                AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                FilterOperator="StringFilterOperator.Contains"
                                Style="width:500px" />
            </RadzenFormField>
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>

@code {
    [Inject] protected ILogger<AmicronCustomerAssign> Logger { get; set; } = default!;
    [Inject] protected IAmicronDataService DataService { get; set; } = default!;

    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }

    private IEnumerable<Adressen>? _customers;
    private int _totalCountCustomers;
    
    private async Task OnCustomerLoadData(LoadDataArgs args)
    {
        var response = await DataService.GetAllAddressAsync(args);

        if (response.Success)
        {
            _customers = response.Data?.Items;
            _totalCountCustomers = response.Data?.TotalCount ?? 0;
        }
    }

    private async Task OnValueChanged(int? customerId)
    {
        Value = customerId;
        await ValueChanged.InvokeAsync(customerId);
    }
}
