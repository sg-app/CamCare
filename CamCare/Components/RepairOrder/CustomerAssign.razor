@using CamCare.Models.Amicron
@using CamCare.Services
@if (!_isCustomerConfirmed)
{
    <RadzenDataGrid TItem="Adressen"
                    Data="_data"
                    LoadData="OnLoadData"
                    IsLoading="_isLoading"
                    Count="_totalCount"
                    AllowPaging="true"
                    PageSize="10"
                    AllowFiltering="true"
                    FilterMode="FilterMode.Simple"
                    Density="Density.Compact"
                    ShowEmptyMessage="false"
                    SelectionMode="DataGridSelectionMode.Single"
                    @bind-Value="_selectedCustomers">
        <Columns>
            <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.KdNummer)" Title="KD-Nr" Width="100px" FilterPlaceholder="Filter" />
            <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.Vorname)" Title="Vorname" MinWidth="200px" Filterable="false" />
            <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.Name)" Title="Nachname" MinWidth="200px" FilterPlaceholder="Filter" />
            <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.Strasse)" Title="Straße" MinWidth="200px" Filterable="false" />
            <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.Plz)" Title="PLZ" Width="80px" FilterPlaceholder="Filter" />
            <RadzenDataGridColumn TItem="Adressen" Property="@nameof(Adressen.Ort)" Title="Ort" MinWidth="200px" FilterPlaceholder="Filter" />
        </Columns>
    </RadzenDataGrid>
}
@if (SelectedCustomer is not null && !_isCustomerConfirmed)
{
    <RadzenButton class="mt-2" Text="Weiter" Click="OnSubmitClicked" />
}


@if (SelectedCustomer is not null && _isCustomerConfirmed)
{
    <RadzenRow>
        <RadzenLabel Text="@($"{SelectedCustomer?.DisplayName}")" />
    </RadzenRow>
    <RadzenRow>
        <RadzenButton class="mt-2" Text="Reset" Click="OnResetClicked" />
    </RadzenRow>

}

@code {
    [Inject] protected ILogger<CustomerAssign> Logger { get; set; } = default!;
    [Inject] protected IAmicronDataService DataService { get; set; } = default!;

    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }

    private IEnumerable<Adressen>? _data;
    private int _totalCount;
    private bool _isLoading;
    private IList<Adressen>? _selectedCustomers;
    private Adressen? SelectedCustomer => _selectedCustomers?.FirstOrDefault();
    private AdressenFilter? _filter;
    private bool _isCustomerConfirmed;

    private async Task OnLoadData(LoadDataArgs args)
    {
        _isLoading = true;
        _filter = new();
        foreach (var filter in args.Filters)
        {
            switch (filter.Property)
            {
                case nameof(Adressen.KdNummer):
                    _filter.KdNummer = filter.FilterValue?.ToString();
                    break;
                case nameof(Adressen.Name):
                    _filter.Name = filter.FilterValue?.ToString();
                    break;
                case nameof(Adressen.Plz):
                    _filter.Plz = filter.FilterValue?.ToString();
                    break;
                case nameof(Adressen.Ort):
                    _filter.Ort = filter.FilterValue?.ToString();
                    break;
            }
        }

        var response = await DataService.GetAllAddressAsync(args, _filter);

        if (response.Success)
        {
            _data = response.Data?.Items;
            _totalCount = response.Data?.TotalCount ?? 0;
        }
        _isLoading = false;
    }

    private async Task OnSubmitClicked(MouseEventArgs args)
    {
        var customerId = SelectedCustomer?.LfdNr;
        Value = customerId;
        await ValueChanged.InvokeAsync(customerId);
        _isCustomerConfirmed = true;
    }

    private async Task OnResetClicked(MouseEventArgs args)
    {
        _selectedCustomers?.Clear();
        Value = null;
        await ValueChanged.InvokeAsync(null);
        _isCustomerConfirmed = false;
    }
}
