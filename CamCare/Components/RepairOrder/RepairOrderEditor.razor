@page "/RepairOrderEditorPage"
@page "/RepairOrderEditorPage/{RepairOrderId:int}"

<RadzenTemplateForm Data="_repairOrder" TItem="RepairOrderVm">
    <FluentValidationValidator @ref="_fluentValidationValidator" />

    <RadzenFieldset Text="Kunde">
        <CustomerAssign Value="_repairOrder.CustomerId" ValueChanged="OnCustomerIdChanged" IsEditMode="_isEditMode" />
    </RadzenFieldset>

    @if (_repairOrder.CustomerId is not null)
    {
        <RadzenFieldset Text="@(_entryWithoutCamera ? "Einzelteil" : "Kamera")">
            <RadzenRow>
                <div class="p-1">
                    <RadzenCheckBox TValue="bool" Value=@_entryWithoutCamera ValueChanged="OnWithoutCameraSelected" Name="_entryWithoutCamera" Disabled="_isEditMode" />
                    <RadzenLabel Text="Erfassung ohne Kamera" Component="_entryWithoutCamera" class="ms-2" />
                </div>
                <div class="p-1">
                    <RadzenCheckBox TValue="bool" Value=@_cameraNotFound ValueChanged="OnCameraNotFountSelected" Name="_cameraNotFound" Disabled="_isEditMode" />
                    <RadzenLabel Text="Nicht in Amicron Liste" Component="_cameraNotFound" class="ms-2" />
                </div>
            </RadzenRow>
            <div class="pt-1">

                @if (_entryWithoutCamera)
                {
                    <RadzenFormField class="d-block" Text="Einzelteil Beschreibung">
                        <RadzenTextBox @bind-Value="_repairOrder.PiceOfEquipment" Style="width:500px" />
                    </RadzenFormField>
                }
                else if (_cameraNotFound)
                {
                    <CameraAssign CustomerId="@_repairOrder.CustomerId" @bind-Value="_repairOrder.CameraSerialNumber" IsEditMode="_isEditMode" />
                    <ValidationMessage For="@(() => _repairOrder.CameraSerialNumber)" />
                }
                else
                {
                    <AmicronCameraAssign CustomerId="@_repairOrder.CustomerId" @bind-Value="_repairOrder.CameraSerialNumber" IsEditMode="_isEditMode" />
                    <ValidationMessage For="@(() => _repairOrder.CameraSerialNumber)" />
                }
            </div>
        </RadzenFieldset>
    }

    @if (_repairOrder.CustomerId is not null)
    {
        <RadzenFieldset Text="Beschreibung">
            <RadzenFormField class="d-block" Text="Zusätzlich mitgelieferte Komponenten">
                <RadzenTextArea @bind-Value="_repairOrder.AdditionalComponents" Cols="100" Rows="2" />
            </RadzenFormField>

            <RadzenFormField class="d-block pt-2" Text="Eingetroffen">
                <RadzenDatePicker @bind-Value="_repairOrder.ArrivedAt" ShowTime="true" DateFormat="dd.MM.yyyy HH:mm" />
            </RadzenFormField>
            <RadzenFormField class="pt-2" Text="Status">
                <RadzenDropDown @bind-Value="_repairOrder.RepairOrderStatusId"
                                Data="_repairOrderStatusData"
                                LoadData="OnLoadRepairOrderStatus"
                                Count="_totalCountRepairOrderStatus"
                                AllowFiltering="true"
                                AllowVirtualization="true"
                                TextProperty="@nameof(RepairOrderStatusVm.Name)"
                                ValueProperty="@nameof(RepairOrderStatusVm.Id)"
                                AllowClear="true"
                                Style="width:500px" />
            </RadzenFormField>
            <div>
                <RadzenLabel Text="@_repairOrderStatusData?.FirstOrDefault(f => f.Id == _repairOrder.RepairOrderStatusId)?.Description" />
            </div>
            <RadzenRadioButtonList class="pt-2" @bind-Value="_repairOrder.ShippingMethod">
                <Items>
                    <RadzenRadioButtonListItem Text="@ShippingMethod.PickedUp.GetDisplayDescription()" Value="ShippingMethod.PickedUp" />
                    <RadzenRadioButtonListItem Text="@ShippingMethod.SentByCustomer.GetDisplayDescription()" Value="ShippingMethod.SentByCustomer" />
                </Items>
            </RadzenRadioButtonList>
            @if (_repairOrder.ShippingMethod == ShippingMethod.PickedUp)
            {
                <LogisticProviderAssign RepairOrder="@_repairOrder" />
            }
            <RadzenFormField class="d-block pt-2" Text="Versandbemerkung">
                <RadzenTextArea @bind-Value="_repairOrder.ShippingMethodDescription" Rows="2" Cols="100" />
            </RadzenFormField>

            <RadzenFormField class="pt-2" Text="Mitarbeiter">
                <RadzenDropDown @bind-Value="_repairOrder.Employees"
                                Data="_employeesData"
                                LoadData="OnLoadEmployees"
                                Count="_totalCountEmployees"
                                Multiple="true"
                                Chips="true"
                                AllowFiltering="true"
                                AllowVirtualization="true"
                                TextProperty="@nameof(EmployeeVm.DisplayName)"
                                AllowClear="true"
                                Style="width:500px" />
            </RadzenFormField>
            <div class="pt-2">
                <DefectiveAssign RepairOrder="@_repairOrder" />
            </div>
            <div class="pt-2">
                <RepairPositionAssign RepairOrder="@_repairOrder" />
            </div>
        </RadzenFieldset>
    }
</RadzenTemplateForm>
<FormButtons Class="pt-2" SaveClick="OnSaveClicked" CancelClick="OnCancelClicked" />

@code {
    [Inject] protected IRepairOrderService RepairOrderService { get; set; } = default!;
    [Inject] protected IRepairOrderStatusService RepairOrderStatusService { get; set; } = default!;
    [Inject] protected IEmployeeService EmployeeService { get; set; } = default!;
    [Inject] protected NavigationManager NavigationManager { get; set; } = default!;
    [Inject] protected IConfiguration Configuration { get; set; } = default!;

    [Parameter] public int RepairOrderId { get; set; }

    private RepairOrderVm _repairOrder = new() { ShippingMethod = ShippingMethod.SentByCustomer, ArrivedAt = DateTime.Now };
    private FluentValidationValidator _fluentValidationValidator = default!;

    private IEnumerable<RepairOrderStatusVm>? _repairOrderStatusData;
    private int _totalCountRepairOrderStatus;

    private IEnumerable<EmployeeVm>? _employeesData;
    private int _totalCountEmployees;

    private IList<DefectiveVm>? _defectives;
    private string? _defectiveDescription;
    private DefectiveVm? _defective;
    private RadzenDataGrid<DefectiveVm> _grid = default!;
    private CancellationTokenSource? _defectiveChangedCts;
    private object? _lastDefectiveChangedValue;
    private bool _entryWithoutCamera;
    private bool _cameraNotFound;

    private bool _isEditMode;

    protected override Task OnInitializedAsync()
    {
        return base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (RepairOrderId > 0)
        {
            var response = await RepairOrderService.GetByIdAsync(RepairOrderId);
            if (response.Success)
            {
                _repairOrder = response.Data ?? new() { ShippingMethod = ShippingMethod.SentByCustomer, ArrivedAt = DateTime.Now };
                _isEditMode = true;
            }
        }
    }

    private async Task OnLoadRepairOrderStatus(LoadDataArgs args)
    {
        ServiceResponse<Paginated<RepairOrderStatusVm>> response;
        if (string.IsNullOrEmpty(args.Filter))
            response = await RepairOrderStatusService.GetAllAsync(args);
        else
            response = await RepairOrderStatusService.GetAllAsync(args, x => x.Name.Contains(args.Filter));
        if (response.Success)
        {
            _repairOrderStatusData = response.Data?.Items ?? [];
            _totalCountRepairOrderStatus = response.Data?.TotalCount ?? 0;
            if (_repairOrder.RepairOrderStatusId == 0 && _repairOrderStatusData?.Any() == true)
            {
                _repairOrder.RepairOrderStatusId = _repairOrderStatusData.FirstOrDefault(r => r.IsDefault)?.Id ?? 0;
            }
        }
    }

    private async Task OnLoadEmployees(LoadDataArgs args)
    {
        ServiceResponse<Paginated<EmployeeVm>> response;
        if (string.IsNullOrEmpty(args.Filter))
            response = await EmployeeService.GetAllAsync(args);
        else
            response = await EmployeeService.GetAllAsync(args, x => x.FirstName.ToLower().Contains(args.Filter.ToLower()) || x.LastName.ToLower().Contains(args.Filter.ToLower()));
        if (response.Success)
        {
            _employeesData = response.Data?.Items ?? [];
            _totalCountEmployees = response.Data?.TotalCount ?? 0;

        }
    }

    private async Task OnSaveClicked(MouseEventArgs args)
    {
        var isValid = await _fluentValidationValidator!.ValidateAsync();
        if (isValid && _repairOrder.Id == 0)
        {
            var response = await RepairOrderService.CreateAsync(_repairOrder);
            if (response.Success)
                _repairOrder = response.Data!;
        }
        else if (isValid)
        {
            await RepairOrderService.UpdateAsync(_repairOrder!.Id, _repairOrder);
        }
        NavigationManager.NavigateTo("/RepairOrderPage");
    }

    private async Task OnDeleteDefectiveRow(DefectiveVm item)
    {
        _repairOrder.Defectives!.Remove(item);
        await _grid.Reload();
    }

    private void OnCancelClicked(MouseEventArgs args)
    {
        NavigationManager.NavigateTo("/RepairOrderPage");
    }

    private void OnCustomerIdChanged(int? args)
    {
        if (args.HasValue)
            _repairOrder.CustomerId = args;
        else
            _repairOrder = new();
    }
    private void OnWithoutCameraSelected(bool args)
    {
        _entryWithoutCamera = args;
        if (args)
        {
            _cameraNotFound = false;
            _repairOrder.CameraSerialNumber = null;
        }
    }
    private void OnCameraNotFountSelected(bool args)
    {
        _cameraNotFound = args;
        _repairOrder.CameraSerialNumber = null;
        if (args)
        {
            _entryWithoutCamera = false;
        }
    }
}
